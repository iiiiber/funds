"""基金数据获取 - 天天基金API"""
import json
import logging
from typing import Optional
import urllib.request
from datetime import datetime

logger = logging.getLogger(__name__)

# 天天基金实时行情接口
TTFUND_GZ_URL = "https://fundgz.1234567.com.cn/js/{code}.js?rt={timestamp}"

# 天天基金历史净值接口
TTFUND_HIST_URL = "https://api.fund.eastmoney.com/f10/lsjz"


def get_realtime_quote(code: str) -> Optional[dict]:
    """获取基金实时行情"""
    import time
    url = TTFUND_GZ_URL.format(code=code, timestamp=int(time.time() * 1000))
    
    try:
        req = urllib.request.Request(url, headers={
            'User-Agent': 'Mozilla/5.0',
            'Referer': 'https://fund.eastmoney.com/'
        })
        with urllib.request.urlopen(req, timeout=10) as resp:
            text = resp.read().decode('utf-8')
        
        text = text.strip()
        if text.startswith('jsonpgz('):
            text = text[7:]
        if text.startswith('('):
            text = text[1:]
        if text.endswith(');'):
            text = text[:-2]
        elif text.endswith(')'):
            text = text[:-1]
        
        data = json.loads(text)
        return {
            'code': data.get('fundcode'),
            'name': data.get('name'),
            'price': float(data.get('dwjz', 0)),
            'change_pct': float(data.get('gszzl', 0)),
            'update_time': data.get('gztime'),
            'estimated_nav': float(data.get('gsz', 0)),
        }
    except Exception as e:
        logger.error(f"获取基金 {code} 行情失败: {e}")
        return None


def get_historical_nav(code: str, days: int = 90) -> list:
    """获取基金历史净值"""
    import re
    
    url = f"https://fund.eastmoney.com/pingzhongdata/{code}.js"
    
    try:
        req = urllib.request.Request(url, headers={
            'User-Agent': 'Mozilla/5.0',
            'Referer': 'https://fund.eastmoney.com/'
        })
        with urllib.request.urlopen(req, timeout=15) as resp:
            text = resp.read().decode('utf-8')
        
        nav_pattern = r'Data_netWorthTrend\s*=\s*\[(.*?)\];'
        match = re.search(nav_pattern, text)
        
        if not match:
            return []
        
        data_str = match.group(1)
        records = []
        
        # 解析 equityReturn 字段
        try:
            items = json.loads(data_str)
            for item in items:
                timestamp = item.get('x', 0)
                nav = item.get('y', 0)
                daily_return = item.get('equityReturn', 0) or 0
                date = datetime.fromtimestamp(timestamp / 1000).strftime('%Y-%m-%d')
                records.append({
                    'date': date,
                    'nav': nav,
                    'accum_nav': nav,
                    'daily_return': daily_return
                })
        except json.JSONDecodeError:
            pattern = r'\{\"x\":(\d+),\"y\":([0-9.]+)(?:,\"equityReturn\":(-?[0-9.]+))?'
            for m in re.finditer(pattern, data_str):
                timestamp = int(m.group(1))
                nav = float(m.group(2))
                daily_return = float(m.group(3)) if m.group(3) else 0
                date = datetime.fromtimestamp(timestamp / 1000).strftime('%Y-%m-%d')
                records.append({
                    'date': date,
                    'nav': nav,
                    'accum_nav': nav,
                    'daily_return': daily_return
                })
        
        records.sort(key=lambda x: x['date'])
        
        if len(records) > days:
            records = records[-days:]
        
        return records
    except Exception as e:
        logger.error(f"获取基金 {code} 历史净值失败: {e}")
        return []


POPULAR_FUNDS = {
    '510300': '沪深300ETF',
    '510050': '50ETF',
    '159915': '创业板ETF',
    '512880': '证券ETF',
    '512760': '芯片ETF',
    '110022': '易方达消费行业',
    '162605': '景顺长城鼎益',
    '005827': '易方达蓝筹精选',
}


if __name__ == '__main__':
    import sys
    code = sys.argv[1] if len(sys.argv) > 1 else '510300'
    
    print(f"📡 获取基金 {code} 实时行情...")
    quote = get_realtime_quote(code)
    if quote:
        print(f"✅ {quote['name']}")
        print(f"   最新净值: {quote['price']:.4f}")
        print(f"   估算涨跌: {quote['change_pct']:+.2f}%")
    
    print(f"\n📊 获取近30天历史净值...")
    hist = get_historical_nav(code, 30)
    print(f"   获取到 {len(hist)} 条记录")
    if hist:
        print(f"   最新: {hist[-1]}")
