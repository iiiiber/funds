#!/usr/bin/env python3
"""增强版基金AI分析 - 整合持仓数据、市场动态、经济指标"""

import sys
import os
from pathlib import Path
sys.path.insert(0, str(Path(__file__).parent.parent))

import requests
from datetime import datetime, timedelta
from core.fund_analyzer import FundAnalyzer
from core.analysis import calculate_volatility, calculate_sharpe_ratio, calculate_max_drawdown
from core.fund_api import get_historical_nav

# MiniMax AI
class MiniMaxAI:
    def __init__(self, api_key: str = None):
        self.api_key = api_key or os.environ.get('MINIMAX_API_KEY', '')
        self.api_url = "https://api.minimaxi.com/anthropic/v1/messages"
        self.model = "MiniMax-M2.7-highspeed"
    
    def chat(self, messages: list, temperature: float = 0.5, max_tokens: int = 800) -> str:
        if not self.api_key:
            return None
        
        headers = {
            "Content-Type": "application/json",
            "x-api-key": self.api_key,
            "anthropic-version": "2023-06-01"
        }
        
        prompt = messages[-1].get('content', '') if messages else ''
        
        data = {
            "model": self.model,
            "messages": [{"role": "user", "content": prompt}],
            "temperature": temperature,
            "max_tokens": max_tokens
        }
        
        try:
            response = requests.post(self.api_url, headers=headers, json=data, timeout=30)
            if response.status_code == 200:
                result = response.json()
                content = result.get('content', [])
                for item in content:
                    if item.get('type') == 'text':
                        return item.get('text', '').strip()
        except Exception as e:
            print(f"AI请求失败: {e}")
        return None


def get_market_indicators() -> dict:
    """获取市场情绪指标"""
    indicators = {
        'market_sentiment': '中性',
        'risk_level': '中等',
        'hot_sectors': [],
        'market_volatility': '适中',
        'fund_flows': '平稳',
        'market_index_change': 0,
    }
    
    try:
        # 获取上证指数
        quote = get_historical_nav('000001', 5)  # 用平安银行模拟市场
        if quote and len(quote) >= 2:
            change = (quote[-1]['nav'] - quote[0]['nav']) / quote[0]['nav'] * 100
            indicators['market_index_change'] = round(change, 2)
            if change > 1:
                indicators['market_sentiment'] = '乐观'
                indicators['risk_level'] = '偏低'
            elif change < -1:
                indicators['market_sentiment'] = '谨慎'
                indicators['risk_level'] = '偏高'
    except:
        pass
    
    return indicators


def calculate_technical_indicators(hist: list) -> dict:
    """计算技术指标"""
    if len(hist) < 10:
        return {'trend': '数据不足'}
    
    prices = [h['nav'] for h in hist]
    
    ma5 = sum(prices[-5:]) / 5
    ma10 = sum(prices[-10:]) / 10 if len(prices) >= 10 else ma5
    ma20 = sum(prices[-20:]) / 20 if len(prices) >= 20 else ma10
    current = prices[-1]
    
    # 趋势判断
    if current > ma5 > ma10 > ma20:
        trend = "强势上升"
    elif current > ma5 and ma5 > ma10:
        trend = "震荡偏强"
    elif current < ma5 < ma10 < ma20:
        trend = "弱势下跌"
    elif current < ma5 and ma5 < ma10:
        trend = "震荡偏弱"
    else:
        trend = "区间震荡"
    
    # 动量
    momentum_5d = (prices[-1] - prices[-5]) / prices[-5] * 100 if len(prices) >= 5 else 0
    momentum_20d = (prices[-1] - prices[-20]) / prices[-20] * 100 if len(prices) >= 20 else 0
    
    # 距离高点的回撤
    max_nav = max(prices)
    drop_from_high = (current - max_nav) / max_nav * 100
    
    return {
        'trend': trend,
        'ma5': round(ma5, 4),
        'ma10': round(ma10, 4),
        'ma20': round(ma20, 4),
        'momentum_5d': round(momentum_5d, 2),
        'momentum_20d': round(momentum_20d, 2),
        'drop_from_high': round(drop_from_high, 2),
    }


def generate_comprehensive_analysis(code: str, holding_info: dict = None) -> dict:
    """生成综合分析结果"""
    
    result = {
        'success': False,
        'code': code,
        'name': '',
        'timestamp': datetime.now().strftime('%Y-%m-%d %H:%M'),
        'holding': {},
        'metrics': {},
        'technical': {},
        'market': {},
        'recommendation': {},
        'ai_report': '',
        'action_suggestions': [],
    }
    
    try:
        # 1. 获取基金基本信息
        from core.fund_api import get_realtime_quote
        quote = get_realtime_quote(code)
        if quote:
            result['name'] = quote.get('name', code)
            result['holding']['current_nav'] = quote.get('price', 0)
            result['holding']['change_pct'] = quote.get('change_pct', 0)
        
        # 2. 获取历史数据
        nav_list = get_historical_nav(code, 90)
        if not nav_list or len(nav_list) < 5:
            result['error'] = '历史数据不足'
            return result
        
        # 3. 计算基础指标
        prices = [h['nav'] for h in nav_list]
        
        result['metrics'] = {
            'return_1m': round((prices[-1] - prices[-22]) / prices[-22] * 100, 2) if len(prices) >= 22 else 0,
            'return_3m': round((prices[-1] - prices[-65]) / prices[-65] * 100, 2) if len(prices) >= 65 else 0,
            'volatility': round(calculate_volatility(nav_list) * 100, 2),
            'sharpe': round(calculate_sharpe_ratio(nav_list), 2),
            'max_drawdown': round(calculate_max_drawdown(nav_list) * 100, 2),
        }
        
        # 4. 计算技术指标
        result['technical'] = calculate_technical_indicators(nav_list)
        
        # 5. 获取市场指标
        result['market'] = get_market_indicators()
        
        # 6. 处理持仓信息 - 确保数值类型转换
        if holding_info:
            result['holding'].update({
                'shares': float(holding_info.get('shares', 0) or 0),
                'cost': float(holding_info.get('cost', 0) or 0),
                'amount': float(holding_info.get('amount', 0) or 0),
                'profit': float(holding_info.get('profit', 0) or 0),
                'profit_pct': float(holding_info.get('profit_pct', 0) or 0),
            })
            
            # 计算持仓详情
            current_nav = result['holding']['current_nav']
            if current_nav > 0 and holding_info.get('shares', 0) > 0:
                current_amount = float(current_nav) * float(holding_info.get('shares', 0))
                result['holding']['current_value'] = round(current_amount, 2)
                result['holding']['profit'] = round(current_amount - float(holding_info.get('cost', 0)) * float(holding_info.get('shares', 0)), 2)
                result['holding']['profit_pct'] = round((current_amount - float(holding_info.get('cost', 0)) * float(holding_info.get('shares', 0))) / (float(holding_info.get('cost', 0)) * float(holding_info.get('shares', 0))) * 100, 2) if holding_info['cost'] > 0 else 0
            else:
                # 如果无法计算，使用holdings传入的盈亏数据
                result['holding']['current_nav'] = 0
                if holding_info.get('profit_pct', 0) != 0:
                    result['holding']['profit_pct'] = holding_info.get('profit_pct', 0)
        
        # 7. 生成评分和建议
        score = 50
        factors = []
        
        # 收益率因素
        ret_1m = result['metrics']['return_1m']
        if 5 < ret_1m < 15:
            score += 15
            factors.append(f"近1月收益{ret_1m:+.1f}%表现良好")
        elif ret_1m > 15:
            score += 5
            factors.append(f"近1月收益{ret_1m:+.1f}%偏高需注意追高风险")
        elif ret_1m < -10:
            score -= 10
            factors.append(f"近1月下跌{ret_1m:.1f}%短期承压")
        
        # 夏普比率
        sharpe = result['metrics']['sharpe']
        if sharpe > 1.5:
            score += 15
            factors.append(f"夏普比率{sharpe:.2f}风险收益比优秀")
        elif sharpe > 1:
            score += 10
            factors.append(f"夏普比率{sharpe:.2f}表现良好")
        
        # 最大回撤
        max_dd = result['metrics']['max_drawdown']
        if max_dd < 10:
            score += 10
            factors.append(f"最大回撤{max_dd:.1f}%风险控制良好")
        elif max_dd > 20:
            score -= 10
            factors.append(f"最大回撤{max_dd:.1f}%风险较高")
        
        # 趋势因素
        trend = result['technical']['trend']
        if '强势' in trend or '偏强' in trend:
            score += 10
            factors.append(f"技术面{trend}")
        elif '弱势' in trend or '偏弱' in trend:
            score -= 5
            factors.append(f"技术面{trend}需关注")
        
        # 持仓盈亏
        if holding_info and holding_info.get('profit_pct', 0) > 10:
            score -= 5
            factors.append(f"持仓盈利{holding_info['profit_pct']:.1f}%注意止盈")
        elif holding_info and holding_info.get('profit_pct', 0) < -10:
            score += 5
            factors.append(f"持仓亏损{holding_info['profit_pct']:.1f}%可考虑补仓")
        
        # 市场情绪
        if result['market']['risk_level'] == '偏高':
            score -= 5
            factors.append("当前市场风险偏高需谨慎")
        
        score = max(0, min(100, score))
        
        # 8. 生成建议
        if score >= 70:
            action = "建议买入/加仓"
            action_level = "积极"
        elif score >= 55:
            action = "建议持有/适度加仓"
            action_level = "稳健"
        elif score >= 40:
            action = "建议持有观察"
            action_level = "中性"
        elif score >= 25:
            action = "建议减仓观望"
            action_level = "谨慎"
        else:
            action = "建议卖出/规避"
            action_level = "风险"
        
        result['recommendation'] = {
            'score': score,
            'action': action,
            'level': action_level,
            'factors': factors,
        }
        
        # 9. 生成AI分析报告
        report_parts = []
        
        # 市场背景
        sentiment = result['market']['market_sentiment']
        if sentiment == '乐观':
            report_parts.append(f"📈 市场情绪{sentiment}，有利于权益类资产")
        elif sentiment == '谨慎':
            report_parts.append(f"⚠️ 市场情绪{sentiment}，建议控制仓位")
        else:
            report_parts.append(f"📊 市场情绪{sentiment}，保持中性配置")
        
        # 基金表现
        name = result['name'] or code
        report_parts.append(f"\n【{name}】")
        report_parts.append(f"• 近1月收益{ret_1m:+.1f}%，近3月{result['metrics']['return_3m']:+.1f}%")
        report_parts.append(f"• 技术面{trend}，夏普比率{sharpe:.2f}")
        
        # 持仓分析
        if holding_info and holding_info.get('shares', 0) > 0:
            profit_pct = result['holding'].get('profit_pct', 0)
            if profit_pct > 0:
                report_parts.append(f"• 您的持仓盈利{profit_pct:.1f}%，建议{'分批止盈' if profit_pct > 15 else '继续持有'}")
            else:
                report_parts.append(f"• 您的持仓亏损{abs(profit_pct):.1f}%，建议{'逢低补仓' if abs(profit_pct) < 15 else '耐心等待反弹'}")
        
        # 操作建议
        report_parts.append(f"\n💡 综合评分{score}分，{action}")
        report_parts.append(f"📋 主要依据：{'；'.join(factors[:3])}")
        
        result['ai_report'] = '\n'.join(report_parts)
        result['success'] = True
        
        # 尝试调用MiniMax AI增强
        try:
            ai = MiniMaxAI()
            prompt = f"""作为专业基金分析师，请根据以下数据给出个性化分析（150字内）：

基金: {result['name']} ({code})
持仓: {'盈利' + str(round(result['holding'].get('profit_pct', 0), 1)) + '%' if result['holding'].get('profit_pct', 0) >= 0 else '亏损' + str(round(abs(result['holding'].get('profit_pct', 0)), 1)) + '%'} | 近1月: {ret_1m:+.1f}% | 波动率: {result['metrics']['volatility']:.1f}% | 夏普: {sharpe:.2f}
技术面: {trend} | 最大回撤: {max_dd:.1f}%

请给出简洁的分析报告，包含：1)简要点评 2)操作建议 3)风险提示。使用中文回复。"""

            ai_result = ai.chat([{"role": "user", "content": prompt}])
            if ai_result and len(ai_result) > 50:
                result['ai_report'] = ai_result
        except Exception as e:
            print(f"MiniMax AI调用失败: {e}")
        
    except Exception as e:
        result['error'] = str(e)
    
    return result


if __name__ == '__main__':
    import json
    
    # 测试
    result = generate_comprehensive_analysis('510300')
    print(json.dumps(result, indent=2, ensure_ascii=False))
