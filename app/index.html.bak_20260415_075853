            '<div style="margin-bottom:1.5rem;"><label style="display:block;font-size:0.875rem;color:#94a3b8;margin-bottom:0.5rem;">备注</label><input id="edit-note" type="text" style="width:100%;padding:0.75rem;background:rgba(30,30,50,0.8);border:1px solid #4f46e5;border-radius:0.75rem;color:white;font-size:1rem;"></div>' +
            '<div style="display:flex;gap:0.75rem;"><button id="edit-save-btn" style="flex:1;padding:0.75rem;background:linear-gradient(135deg,#4f46e5,#7c3aed);border:none;border-radius:0.75rem;color:white;font-weight:600;cursor:pointer;">保存</button>' +
            '<button id="edit-cancel-btn" style="flex:1;padding:0.75rem;background:rgba(100,116,139,0.3);border:none;border-radius:0.75rem;color:#cbd5e1;font-weight:600;cursor:pointer;">取消</button></div></div></div>';
        document.body.insertAdjacentHTML('beforeend', modalHtml);
        modal = document.getElementById('edit-modal');
        document.getElementById('edit-save-btn').onclick = saveFund;
        document.getElementById('edit-cancel-btn').onclick = closeEditModal;
    }
    document.getElementById('edit-code').value = code;
    document.getElementById('edit-fund-code').value = code;
    document.getElementById('edit-shares').value = shares;
    document.getElementById('edit-cost').value = cost;
    document.getElementById('edit-note').value = note ? note.replace(/&quot;/g, '"') : '';
    modal.style.display = 'flex';
}

function saveFund() {
    var code = document.getElementById('edit-code').value;
    var shares = parseFloat(document.getElementById('edit-shares').value) || 0;
    var cost = parseFloat(document.getElementById('edit-cost').value) || 0;
    var note = document.getElementById('edit-note').value;
    fetch('/api/holdings/' + code, {method: 'PUT', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({shares: shares, cost: cost, note: note})})
    .then(function(res) { return res.json(); })
    .then(function(data) { if (data.success) { closeEditModal(); refreshHoldings(); } else { alert(data.error || '保存失败'); } })
    .catch(function(e) { alert('请求失败: ' + e.message); });
}

function closeEditModal() {
    var modal = document.getElementById('edit-modal');
    if (modal) modal.style.display = 'none';
}

function deleteFund(code) {
    if (!confirm("确定要删除这只基金吗？")) return;
    fetch("/api/holdings/" + code, {method: "DELETE"})
        .then(function(res) { return res.json(); })
        .then(function(data) { if (data.success) refreshHoldings(); })
        .catch(function(e) { alert("删除失败: " + e.message); });
}

