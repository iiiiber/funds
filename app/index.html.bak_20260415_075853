<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FundQuant - 基金量化助手</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { font-family: "Inter", system-ui, sans-serif; }
        body { background: linear-gradient(135deg, #0f0f1a 0%, #1a1a2e 50%, #16213e 100%); min-height: 100vh; margin: 0; padding: 0; }
        .glass-card { background: rgba(30, 30, 50, 0.7); backdrop-filter: blur(20px); border: 1px solid rgba(99, 102, 241, 0.15); box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3); }
        .glass-card:hover { border-color: rgba(99, 102, 241, 0.3); transform: translateY(-2px); }
        .btn-gradient { background: linear-gradient(135deg, #6366f1 0%, #ec4899 100%); box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4); }
        .btn-secondary { background: rgba(99, 102, 241, 0.15); border: 1px solid rgba(99, 102, 241, 0.3); }
        .tab-btn { padding: 0.5rem 0.75rem; border-radius: 0.5rem; font-size: 0.875rem; font-weight: 500; display: flex; align-items: center; gap: 0.25rem; transition: all 0.2s; }
        .tab-btn.active { background: linear-gradient(135deg, rgba(99, 102, 241, 0.2) 0%, rgba(236, 72, 153, 0.15) 100%); }
        .positive { color: #f472b6; }
        .negative { color: #34d399; }
        .rec-type-btn { background: rgba(30, 30, 50, 0.6); border: 1px solid rgba(99, 102, 241, 0.2); padding: 0.5rem 1rem; border-radius: 0.75rem; font-size: 0.875rem; display: flex; align-items: center; gap: 0.25rem; }
        .rec-type-btn.active { background: linear-gradient(135deg, rgba(99, 102, 241, 0.3) 0%, rgba(236, 72, 153, 0.2) 100%); border-color: rgba(99, 102, 241, 0.5); }
        .ai-report-card { background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(236, 72, 153, 0.08) 100%); border: 1px solid rgba(99, 102, 241, 0.2); }
        input, select { background: rgba(30, 30, 50, 0.6) !important; border: 1px solid rgba(99, 102, 241, 0.2) !important; padding: 0.75rem 1rem !important; border-radius: 0.75rem !important; color: white !important; font-size: 1rem !important; }
        input::placeholder { color: rgba(148, 163, 184, 0.5); }
        input:focus, select:focus { border-color: rgba(99, 102, 241, 0.5) !important; outline: none !important; }
        .spinner { border: 2px solid rgba(99, 102, 241, 0.2); border-top: 2px solid #6366f1; border-radius: 50%; width: 20px; height: 20px; animation: spin 1s linear infinite; display: inline-block; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        @media (max-width: 640px) { .tab-btn span { display: none; } .tab-btn { padding: 0.5rem; } .glass-card { padding: 1rem !important; } }
    </style>
</head>
<body class="text-white">
    <nav class="glass-card sticky top-0 z-50 border-b border-indigo-500/20 px-3 py-3 sm:px-4 sm:py-4">
        <div class="flex justify-between items-center">
            <div class="flex items-center gap-2 sm:gap-3">
                <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-pink-500 flex items-center justify-center"><svg class="w-5 h-5 text-white"><use href="#icon-logo"/></svg></div>
                <div><h1 class="text-base sm:text-xl font-bold bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">FundQuant</h1><p class="text-xs text-slate-400 hidden sm:block">智能基金量化助手</p></div>
            </div>
            <div class="hidden sm:flex gap-1 lg:gap-2">
                <button id="tab-btn-holdings" class="tab-btn active"><svg class="w-4 h-4"><use href="#icon-holdings"/></svg><span>持仓</span></button>
                <button id="tab-btn-portfolio" class="tab-btn"><svg class="w-4 h-4"><use href="#icon-portfolio"/></svg><span>组合</span></button>
                <button id="tab-btn-recommend" class="tab-btn"><svg class="w-4 h-4"><use href="#icon-recommend"/></svg><span>推荐</span></button>
                <button id="tab-btn-add" class="tab-btn"><svg class="w-4 h-4"><use href="#icon-add"/></svg><span>添加</span></button>
            </div>
        </div>
        <div class="flex gap-1 mt-3 sm:hidden">
            <button id="tab-btn-holdings-m" class="tab-btn active flex-shrink-0"><svg class="w-5 h-5"><use href="#icon-holdings"/></svg></button>
            <button id="tab-btn-portfolio-m" class="tab-btn flex-shrink-0"><svg class="w-5 h-5"><use href="#icon-portfolio"/></svg></button>
            <button id="tab-btn-recommend-m" class="tab-btn flex-shrink-0"><svg class="w-5 h-5"><use href="#icon-recommend"/></svg></button>
            <button id="tab-btn-add-m" class="tab-btn flex-shrink-0"><svg class="w-5 h-5"><use href="#icon-add"/></svg></button>
        </div>
    </nav>

    <main class="px-3 py-4 sm:px-6 sm:py-6 max-w-6xl mx-auto">
        <div id="tab-holdings" class="tab-content">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4 sm:mb-6">
                <div><h2 class="text-lg sm:text-xl font-semibold text-white">我的持仓</h2><p class="text-xs sm:text-sm text-slate-400 mt-1">实时监控您的基金表现</p></div>
                <div class="flex gap-2 w-full sm:w-auto">
                    <button id="refresh-btn" class="btn-secondary flex-1 sm:flex-none px-3 sm:px-4 py-2 rounded-xl text-sm font-medium flex items-center justify-center gap-2"><svg class="w-4 h-4"><use href="#icon-refresh"/></svg><span class="hidden sm:inline">刷新</span></button>
                    <button id="ai-analyze-all-btn" class="btn-gradient flex-1 sm:flex-none px-3 sm:px-4 py-2 rounded-xl text-sm font-medium flex items-center justify-center gap-2"><svg class="w-4 h-4"><use href="#icon-ai"/></svg><span class="hidden sm:inline">AI分析</span></button>
                </div>
            </div>
            <div id="holdings-list" class="grid gap-3 sm:gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"><div class="col-span-full text-center py-12 text-slate-400"><svg class="w-16 h-16 mx-auto mb-4 opacity-30"><use href="#icon-holdings"/></svg><p>加载中...</p></div></div>
            <div id="ai-report-area" class="mt-4 sm:mt-8 hidden">
                <div class="flex justify-between items-center mb-3 sm:mb-4"><h3 class="text-base sm:text-lg font-semibold flex items-center gap-2 text-white"><svg class="w-5 h-5 text-indigo-400"><use href="#icon-ai"/></svg>AI量化分析报告</h3><button id="clear-reports-btn" class="text-slate-400 hover:text-white text-xs sm:text-sm flex items-center gap-1"><svg class="w-4 h-4"><use href="#icon-delete"/></svg>清除</button></div>
