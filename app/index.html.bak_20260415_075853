function loadPortfolioAnalysis() {
    var adviceEl = document.getElementById("portfolio-advice");
    var warnEl = document.getElementById("correlation-warning");
    if (adviceEl) adviceEl.innerHTML = '<p class="text-center py-4">加载中...</p>';
    if (warnEl) warnEl.classList.add("hidden");
    
    fetch("/api/recommend/portfolio")
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (!data.success) { if (adviceEl) adviceEl.innerHTML = '<p class="text-slate-400 text-center py-8">请先添加持仓</p>'; return; }
            var pd = data.data;
            
            // 更新各指标显示
            document.getElementById("portfolio-score").textContent = (pd.portfolio_score || 0);
            document.getElementById("portfolio-risk").textContent = pd.risk_level || "--";
            document.getElementById("portfolio-div").textContent = (pd.diversification_score || 0);
            document.getElementById("portfolio-vol").textContent = (pd.avg_volatility || 0) + "%";
            document.getElementById("portfolio-sharpe").textContent = (pd.avg_sharpe || 0).toFixed(2);
            
            // 显示相关性警告
            if (warnEl && pd.correlation_warning) {
                warnEl.textContent = pd.correlation_warning;
                warnEl.classList.remove("hidden");
            }
            
            // 生成配置建议
            if (adviceEl) {
                var advice = "";
                var rl = pd.risk_level || "";
                var score = pd.portfolio_score || 0;
                var div = pd.diversification_score || 0;
                
                if (rl.indexOf("激进") >= 0) advice = "当前组合风险偏高，建议增加债券或稳健型基金分散风险";
                else if (rl.indexOf("积极") >= 0) advice = "组合偏积极，建议保持，关注市场波动";
                else if (rl.indexOf("稳健") >= 0) advice = "组合风险适中，可适当配置成长型基金";
                else if (rl.indexOf("保守") >= 0) advice = "组合偏保守，可考虑适度增加权益类配置";
                
                if (div < 40) advice += " 分散度偏低，建议增加不同类型基金";
                if (score >= 70) advice += " 组合表现优秀，继续保持";
                else if (score >= 50) advice += " 组合整体尚可，可进一步优化";
                
                adviceEl.innerHTML = '<p class="text-sm">' + advice + '</p>';
            }
        })
        .catch(function(e) { if (adviceEl) adviceEl.innerHTML = '<p class="text-red-400">加载失败</p>'; });
}

