            <div class="mb-4 sm:mb-6"><h2 class="text-lg sm:text-xl font-semibold text-white">智能基金推荐</h2><p class="text-xs sm:text-sm text-slate-400 mt-1">基于多维度分析为您精选优质基金</p></div>
            <div class="glass-card rounded-xl p-4 sm:p-5 mb-4 sm:mb-6">
                <div class="flex gap-2 mb-4 overflow-x-auto pb-2">
                    <button id="btn-momentum" class="rec-type-btn active flex-shrink-0"><svg class="w-4 h-4"><use href="#icon-rocket"/></svg><span>动量</span></button>
                    <button id="btn-contrarian" class="rec-type-btn flex-shrink-0"><svg class="w-4 h-4"><use href="#icon-reverse"/></svg><span>反转</span></button>
                    <button id="btn-low_vol" class="rec-type-btn flex-shrink-0"><svg class="w-4 h-4"><use href="#icon-shield"/></svg><span>稳健</span></button>
                    <button id="btn-high_sharpe" class="rec-type-btn flex-shrink-0"><svg class="w-4 h-4"><use href="#icon-chart"/></svg><span>高夏普</span></button>
                    <button id="btn-diversify" class="rec-type-btn flex-shrink-0"><svg class="w-4 h-4"><use href="#icon-diverse"/></svg><span>分散</span></button>
                </div>
                <div id="type-description" class="text-slate-400 text-xs sm:text-sm mb-3"></div>
                <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">
                    <select id="category-select" class="w-full sm:w-auto text-sm"><option value="all">全部基金</option><option value="broad_index">宽基指数</option><option value="industry">行业主题</option><option value="bond">债券稳健</option><option value="qdii">海外QDII</option></select>
                    <span class="text-slate-500 text-xs sm:text-sm" id="pool-info">候选: --</span>
                </div>
            </div>
            <div id="recommend-list" class="grid gap-3 sm:gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"><div class="col-span-full text-center py-12 text-slate-400"><svg class="w-16 h-16 mx-auto mb-4 opacity-30"><use href="#icon-recommend"/></svg><p>加载中...</p></div></div>
        </div>

        <div id="tab-add" class="tab-content hidden">
            <div class="mb-4 sm:mb-6"><h2 class="text-lg sm:text-xl font-semibold text-white">添加基金</h2><p class="text-xs sm:text-sm text-slate-400 mt-1">将新基金添加到您的持仓列表</p></div>
            <form id="add-form" class="glass-card rounded-xl p-4 sm:p-6 max-w-lg space-y-4">
                <div><label class="block text-xs sm:text-sm text-slate-400 mb-2">基金代码</label><input type="text" id="fund-code" placeholder="如: 510300" class="w-full"></div>
                <div><label class="block text-xs sm:text-sm text-slate-400 mb-2">基金名称 (自动获取)</label><input type="text" id="fund-name" placeholder="输入代码后自动获取" readonly class="w-full"></div>
                <div class="grid grid-cols-2 gap-3">
                    <div><label class="block text-xs sm:text-sm text-slate-400 mb-2">持有份额</label><input type="number" id="fund-shares" placeholder="0" class="w-full"></div>
                    <div><label class="block text-xs sm:text-sm text-slate-400 mb-2">买入成本</label><input type="number" step="0.001" id="fund-cost" placeholder="0.00" class="w-full"></div>
                </div>
                <div><label class="block text-xs sm:text-sm text-slate-400 mb-2">备注</label><input type="text" id="fund-note" placeholder="如: 主要仓位" class="w-full"></div>
                <button type="submit" class="w-full btn-gradient py-3 rounded-xl font-semibold text-white flex items-center justify-center gap-2"><svg class="w-5 h-5"><use href="#icon-add"/></svg>添加持仓</button>
            </form>
        </div>
    </main>
    
