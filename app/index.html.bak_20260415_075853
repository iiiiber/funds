function analyzeAllFunds() {
    var btn = document.getElementById("ai-analyze-all-btn");
    if (isAnalyzingAll) return;
    isAnalyzingAll = true;
    btn.innerHTML = '<span class="spinner"></span> 分析中...';
    btn.disabled = true;
    
    var reportArea = document.getElementById("ai-report-area");
    var container = document.getElementById("ai-reports-container");
    if (reportArea) reportArea.classList.remove("hidden");
    if (container) container.innerHTML = "";
    
    if (currentHoldings.length === 0) {
        fetch("/api/holdings")
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data.success && data.data) currentHoldings = data.data;
                if (currentHoldings.length === 0) { showError("请先添加持仓"); }
                else { analyzeAllRecursive(0); }
            });
    } else {
        analyzeAllRecursive(0);
    }
}

function analyzeAllRecursive(index) {
    if (index >= currentHoldings.length) {
        isAnalyzingAll = false;
        var btn = document.getElementById("ai-analyze-all-btn");
        btn.innerHTML = '<svg class="w-4 h-4"><use href="#icon-ai"/></svg><span class="hidden sm:inline">AI分析</span>';
        btn.disabled = false;
        return;
    }
    var fund = currentHoldings[index];
    fetch("/api/analyze/" + fund.code)
        .then(function(res) { return res.json(); })
        .then(function(data) { if (data.success) { showAIReport(data.data, fund.code, fund.name || fund.code); } })
        .catch(function(e) {})
        .finally(function() { setTimeout(function() { analyzeAllRecursive(index + 1); }, 1000); });
}

function showAIReport(data, code, name) {
    var container = document.getElementById("ai-reports-container");
    if (!container) return;
    
    var displayName = escapeHtml(name || code);
    var rec = data.recommendation || {};
    var score = rec.score || 0;
    var holding = data.holding || {};
    var metrics = data.metrics || {};
    var technical = data.technical || {};
    var market = data.market || {};
    
    var scoreClass = score >= 70 ? "text-emerald-400" : score >= 50 ? "text-indigo-400" : "text-slate-400";
    var momClass = (metrics.return_1m || 0) >= 0 ? "positive" : "negative";
    var momSign = (metrics.return_1m || 0) >= 0 ? "+" : "";
    
    var html = '<div class="ai-report-card rounded-xl p-4">';
    html += '<div class="flex justify-between items-start mb-4">';
    html += '<div><h4 class="font-semibold text-white text-sm">' + displayName + '</h4>';
    html += '<p class="text-slate-400 text-xs">' + escapeHtml(code) + ' | ' + escapeHtml(data.timestamp || '') + '</p></div>';
    html += '<div class="text-right"><div class="text-3xl font-bold ' + scoreClass + '">' + score + '</div><div class="text-xs text-slate-500">综合评分</div></div>';
    html += '</div>';
    
    if (market.market_sentiment) {
        var sentimentColor = market.market_sentiment === "乐观" ? "bg-emerald-500/20 text-emerald-400" : market.market_sentiment === "谨慎" ? "bg-red-500/20 text-red-400" : "bg-slate-500/20 text-slate-400";
        html += '<div class="mb-4 p-2 rounded-lg bg-slate-800/30 text-xs">';
        html += '<span class="inline-flex items-center gap-1 px-2 py-1 rounded ' + sentimentColor + '">' + escapeHtml(market.market_sentiment) + ' | 风险' + escapeHtml(market.risk_level || '') + '</span>';
        html += ' | 指数涨跌' + escapeHtml(market.market_index_change || 0) + '%</div>';
    }
    
    if (holding.shares && holding.shares > 0) {
        var holdingProfit = holding.profit_pct || 0;
        var holdingProfitClass = holdingProfit >= 0 ? "positive" : "negative";
        var holdingProfitSign = holdingProfit >= 0 ? "+" : "";
        html += '<div class="mb-4 p-3 rounded-lg bg-indigo-500/10 border border-indigo-500/20">';
        html += '<div class="flex items-center gap-2 mb-2"><svg class="w-4 h-4 text-indigo-400"><use href="#icon-money"/></svg><span class="text-indigo-400 font-semibold text-sm">我的持仓</span></div>';
        html += '<div class="grid grid-cols-4 gap-2 text-xs">';
        html += '<div><span class="text-slate-400">份额</span><p class="font-mono text-white mt-1">' + (holding.shares || 0) + '</p></div>';
        html += '<div><span class="text-slate-400">成本</span><p class="font-mono text-white mt-1">' + (holding.cost ? '¥' + holding.cost.toFixed(2) : '-') + '</p></div>';
        html += '<div><span class="text-slate-400">当前值</span><p class="font-mono text-white mt-1">' + (holding.current_value ? '¥' + Math.round(holding.current_value).toLocaleString() : '-') + '</p></div>';
        html += '<div><span class="text-slate-400">盈亏</span><p class="' + holdingProfitClass + ' font-mono font-bold mt-1">' + holdingProfitSign + holdingProfit.toFixed(1) + '%</p></div>';
        html += '</div></div>';
    }
    
    html += '<div class="grid grid-cols-4 gap-2 mb-4 text-xs">';
    html += '<div class="bg-slate-800/50 rounded-lg p-2 text-center"><span class="text-slate-400">近1月</span><p class="' + momClass + ' font-mono font-bold mt-1">' + momSign + (metrics.return_1m || 0).toFixed(1) + '%</p></div>';
    html += '<div class="bg-slate-800/50 rounded-lg p-2 text-center"><span class="text-slate-400">夏普</span><p class="font-mono font-bold mt-1">' + (metrics.sharpe || 0).toFixed(2) + '</p></div>';
    html += '<div class="bg-slate-800/50 rounded-lg p-2 text-center"><span class="text-slate-400">波动率</span><p class="font-mono mt-1">' + (metrics.volatility || 0).toFixed(1) + '%</p></div>';
    html += '<div class="bg-slate-800/50 rounded-lg p-2 text-center"><span class="text-slate-400">最大回撤</span><p class="text-red-400 font-mono mt-1">-' + (metrics.max_drawdown || 0).toFixed(1) + '%</p></div>';
    html += '</div>';
    
    if (technical.trend) {
        var trendColor = technical.trend.indexOf("强") >= 0 || technical.trend.indexOf("偏强") >= 0 ? "text-emerald-400" : technical.trend.indexOf("弱") >= 0 ? "text-red-400" : "text-amber-400";
        html += '<div class="mb-3 text-xs"><span class="text-slate-400">技术面:</span> <span class="' + trendColor + ' font-semibold">' + escapeHtml(technical.trend) + '</span></div>';
    }
    
    if (rec.action) {
        var actionColor = rec.action.indexOf("买入") >= 0 || rec.action.indexOf("加仓") >= 0 ? "bg-emerald-500/20 text-emerald-400" : rec.action.indexOf("减仓") >= 0 || rec.action.indexOf("卖出") >= 0 ? "bg-red-500/20 text-red-400" : "bg-amber-500/20 text-amber-400";
        html += '<div class="mb-3 p-3 rounded-lg ' + actionColor + '">';
        html += '<span class="font-semibold">' + escapeHtml(rec.action) + '</span>';
        if (rec.factors && rec.factors.length > 0) { html += '<p class="text-xs mt-1 opacity-80">' + escapeHtml(rec.factors.join('；')) + '</p>'; }
        html += '</div>';
    }
    
    var reportText = data.ai_report || '';
    if (reportText) {
        html += '<div class="border-t border-indigo-500/20 pt-4"><h5 class="text-sm font-semibold text-indigo-400 mb-2 flex items-center gap-2"><svg class="w-4 h-4"><use href="#icon-ai"/></svg>AI分析报告</h5>';
        html += '<div class="text-slate-300 text-xs leading-relaxed max-h-48 overflow-y-auto">' + formatText(reportText) + '</div></div>';
    }
    
    html += '</div>';
    container.insertAdjacentHTML("beforeend", html);
}

