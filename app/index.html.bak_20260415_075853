document.addEventListener("click", function(e) {
    var target = e.target.closest('button');
    if (!target) return;
    if (target.classList.contains("ai-btn")) { analyzeSingleFund(target.dataset.code, target.dataset.name, target); }
    else if (target.classList.contains("similar-btn")) { findSimilar(target.dataset.code); }
    else if (target.classList.contains("edit-btn")) { editFund(target.dataset.code, target.dataset.shares, target.dataset.cost, target.dataset.note); }
    else if (target.classList.contains("delete-btn")) { deleteFund(target.dataset.code); }
    else if (target.classList.contains("add-btn")) { addToPortfolio(target.dataset.code, target.dataset.name); }
});

document.getElementById("add-form").onsubmit = function(e) {
    e.preventDefault();
    var code = document.getElementById("fund-code").value.trim();
    if (!code) { alert("请输入基金代码"); return; }
    fetch("/api/holdings", { method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify({code: code, name: document.getElementById("fund-name").value, shares: parseFloat(document.getElementById("fund-shares").value) || 0, cost: parseFloat(document.getElementById("fund-cost").value) || 0, note: document.getElementById("fund-note").value}) })
    .then(function(res) { return res.json(); })
    .then(function(data) { if (data.success) { alert("添加成功！"); document.getElementById("add-form").reset(); showTab("holdings"); } else { alert(data.error || "添加失败"); } })
    .catch(function(e) { alert("请求失败: " + e.message); });
};

document.getElementById("fund-code").onblur = function(e) {
    var code = e.target.value.trim();
    if (code && code.length === 6) {
        fetch("/api/fund/" + code)
            .then(function(res) { return res.json(); })
            .then(function(data) { if (data.success && data.quote) { document.getElementById("fund-name").value = data.quote.name; } })
            .catch(function() {});
    }
};

