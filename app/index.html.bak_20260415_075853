    <script>
var currentRecommendType = "momentum";
var currentHoldings = [];
var isAnalyzingAll = false;

var typeDescriptions = {
    "momentum": "<strong style=color:#818cf8>动量型</strong>：追涨强势基金，近90日涨幅高",
    "contrarian": "<strong style=color:#f472b6>反转型</strong>：超跌反弹机会，近期跌但中长期稳健",
    "low_vol": "<strong style=color:#34d399>稳健型</strong>：低波动、低回撤，追求稳定收益",
    "high_sharpe": "<strong style=color:#fbbf24>高夏普</strong>：风险调整收益最优",
    "diversify": "<strong style=color:#a78bfa>分散型</strong>：综合评分高，互补现有持仓"
};

function escapeHtml(str) {
    if (!str) return "";
    var div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
}

function formatText(str) {
    if (!str) return "";
    return str.replace(/\n/g, '<br>').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
}

function showError(message) {
    var el = document.getElementById("error-area");
    document.getElementById("error-content").textContent = message;
    el.classList.remove("hidden");
    setTimeout(function() { el.classList.add("hidden"); }, 5000);
}

function showTab(tab) {
    document.querySelectorAll(".tab-content").forEach(function(el) { el.classList.add("hidden"); });
    document.querySelectorAll(".tab-btn").forEach(function(el) { el.classList.remove("active"); });
    var targetTab = document.getElementById("tab-" + tab);
    if (targetTab) targetTab.classList.remove("hidden");
    var targetBtn = document.getElementById("tab-btn-" + tab);
    if (targetBtn) targetBtn.classList.add("active");
    var targetBtnM = document.getElementById("tab-btn-" + tab + "-m");
    if (targetBtnM) targetBtnM.classList.add("active");
    
    // 根据tab自动加载数据
    if (tab === "portfolio") loadPortfolioAnalysis();
    else if (tab === "recommend") loadRecommend();
    else if (tab === "holdings") refreshHoldings();
}

function setRecommendType(type) {
    currentRecommendType = type;
    document.querySelectorAll(".rec-type-btn").forEach(function(btn) { btn.classList.remove("active"); });
    var btn = document.getElementById("btn-" + type);
    if (btn) btn.classList.add("active");
    var desc = document.getElementById("type-description");
    if (desc) desc.innerHTML = typeDescriptions[type] || "";
    loadRecommend();
}

// 刷新持仓
function refreshHoldings() {
    var container = document.getElementById("holdings-list");
    var refreshBtn = document.getElementById("refresh-btn");
    
    // 显示加载状态
    if (refreshBtn) {
        refreshBtn.disabled = true;
        refreshBtn.innerHTML = '<svg class="w-4 h-4 animate-spin"><use href="#icon-refresh"/></svg><span class="hidden sm:inline">刷新中...</span>';
    }
    
    if (container) {
        container.innerHTML = '<div class="col-span-full text-center py-12 text-slate-400"><svg class="w-8 h-8 mx-auto animate-spin"><use href="#icon-refresh"/></svg><p class="mt-4">加载中...</p></div>';
    }
    
    fetch("/api/holdings")
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success && data.data && data.data.length > 0) {
                currentHoldings = data.data;
                var html = "";
                data.data.forEach(function(f) {
                    var name = escapeHtml(f.name || f.code);
                    var code = escapeHtml(f.code);
                    var changeClass = (f.change_pct >= 0) ? "positive" : "negative";
                    var changeSign = (f.change_pct >= 0) ? "+" : "";
                    var profitClass = (f.profit_pct >= 0) ? "positive" : "negative";
                    var profitSign = (f.profit_pct >= 0) ? "+" : "";
                    var trendIcon = f.change_pct >= 0 ? "#icon-trend-up" : "#icon-trend-down";
                    
                    html += '<div class="glass-card rounded-xl p-4">';
                    html += '<div class="flex justify-between items-start mb-3">';
                    html += '<div><h3 class="font-semibold text-white text-sm">' + name + '</h3><p class="text-slate-400 text-xs mt-1">' + code + '</p></div>';
