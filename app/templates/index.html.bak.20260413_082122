<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FundQuant - 基金量化助手</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .positive { color: #ef4444; }
        .negative { color: #22c55e; }
        .card { background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); }
        .glow { box-shadow: 0 0 20px rgba(59, 130, 246, 0.3); }
    </style>
</head>
<body class="bg-slate-900 text-white min-h-screen">
    <!-- 导航栏 -->
    <nav class="bg-slate-800 border-b border-slate-700 px-6 py-4">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <h1 class="text-2xl font-bold bg-gradient-to-r from-blue-400 to-purple-500 bg-clip-text text-transparent">
                📈 FundQuant
            </h1>
            <div class="flex gap-4">
                <button onclick="showTab('holdings')" class="tab-btn px-4 py-2 rounded-lg hover:bg-slate-700 transition" data-tab="holdings">
                    📊 我的持仓
                </button>
                <button onclick="showTab('recommend')" class="tab-btn px-4 py-2 rounded-lg hover:bg-slate-700 transition" data-tab="recommend">
                    🏆 基金推荐
                </button>
                <button onclick="showTab('add')" class="tab-btn px-4 py-2 rounded-lg hover:bg-slate-700 transition" data-tab="add">
                    ➕ 添加基金
                </button>
            </div>
        </div>
    </nav>

    <!-- 主内容 -->
    <main class="max-w-6xl mx-auto p-6">
        <!-- 持仓 Tab -->
        <div id="tab-holdings" class="tab-content">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-xl font-semibold">我的持仓</h2>
                <button onclick="refreshHoldings()" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg transition">
                    🔄 刷新行情
                </button>
            </div>
            <div id="holdings-list" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                <div class="text-slate-400">加载中...</div>
            </div>
        </div>

        <!-- 推荐 Tab -->
        <div id="tab-recommend" class="tab-content hidden">
            <h2 class="text-xl font-semibold mb-6">🎯 智能基金推荐</h2>
            
            <!-- 推荐策略选择 -->
            <div class="bg-slate-800 rounded-xl p-4 mb-6">
                <div class="flex flex-wrap gap-2 mb-4">
                    <button onclick="setRecommendType('momentum')" id="btn-momentum" class="rec-type-btn px-4 py-2 rounded-lg bg-blue-600 transition">
                        🚀 动量型
                    </button>
                    <button onclick="setRecommendType('contrarian')" id="btn-contrarian" class="rec-type-btn px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 transition">
                        🔄 反转型
                    </button>
                    <button onclick="setRecommendType('low_vol')" id="btn-low_vol" class="rec-type-btn px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 transition">
                        🛡️ 稳健型
                    </button>
                    <button onclick="setRecommendType('high_sharpe')" id="btn-high_sharpe" class="rec-type-btn px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 transition">
                        📈 高夏普
                    </button>
                    <button onclick="setRecommendType('diversify')" id="btn-diversify" class="rec-type-btn px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 transition">
                        🎨 分散型
                    </button>
                </div>
                
                <!-- 策略说明 -->
                <div id="type-description" class="text-slate-400 text-sm">
                    <strong>🚀 动量型</strong>：追涨强势基金，适合趋势行情
                </div>
                
                <!-- 基金分类选择 -->
                <div class="flex flex-wrap gap-2 mt-4">
                    <select id="category-select" onchange="loadRecommend()" class="bg-slate-700 rounded-lg px-3 py-2 text-sm">
                        <option value="all">全部基金</option>
                        <option value="broad_index">宽基指数</option>
                        <option value="industry">行业主题</option>
                        <option value="bond">债券稳健</option>
                        <option value="qdii">海外QDII</option>
                    </select>
                    <span class="text-slate-500 text-sm self-center" id="pool-info">候选基金: --</span>
                </div>
            </div>
            
            <div id="recommend-list" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                <div class="text-slate-400">加载中...</div>
            </div>
        </div>

        <!-- 添加 Tab -->
        <div id="tab-add" class="tab-content hidden">
            <h2 class="text-xl font-semibold mb-6">添加基金</h2>
            <form id="add-form" class="max-w-md bg-slate-800 rounded-xl p-6 space-y-4">
                <div>
                    <label class="block text-sm text-slate-400 mb-1">基金代码</label>
                    <input type="text" id="fund-code" placeholder="如: 510300" 
                           class="w-full bg-slate-700 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-sm text-slate-400 mb-1">基金名称 (自动获取)</label>
                    <input type="text" id="fund-name" placeholder="自动获取" readonly
                           class="w-full bg-slate-700 rounded-lg px-4 py-2 opacity-70">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm text-slate-400 mb-1">持有份额</label>
                        <input type="number" id="fund-shares" placeholder="0"
                               class="w-full bg-slate-700 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    <div>
                        <label class="block text-sm text-slate-400 mb-1">买入成本</label>
                        <input type="number" step="0.001" id="fund-cost" placeholder="0.00"
                               class="w-full bg-slate-700 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                </div>
                <div>
                    <label class="block text-sm text-slate-400 mb-1">备注</label>
                    <input type="text" id="fund-note" placeholder="如: 主要仓位"
                           class="w-full bg-slate-700 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 py-3 rounded-lg font-semibold transition">
                    ✅ 添加持仓
                </button>
            </form>
        </div>
    </main>

    <script>
        // 全局状态
        let currentRecommendType = 'momentum';
        
        // 推荐策略说明
        const typeDescriptions = {
            'momentum': '<strong>🚀 动量型</strong>：追涨强势基金，近90日涨幅高，适合趋势行情',
            'contrarian': '<strong>🔄 反转型</strong>：超跌反弹机会，近期跌幅大但基本面稳健',
            'low_vol': '<strong>🛡️ 稳健型</strong>：低波动、低回撤，追求稳定收益',
            'high_sharpe': '<strong>📈 高夏普</strong>：风险调整收益最优，性价比最高',
            'diversify': '<strong>🎨 分散型</strong>：综合评分高，可作为组合配置补充',
        };
        
        // Tab 切换
        function showTab(tab) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('bg-blue-600'));
            document.getElementById('tab-' + tab).classList.remove('hidden');
            event.target.classList.add('bg-blue-600');
            
            if (tab === 'holdings') refreshHoldings();
            if (tab === 'recommend') loadRecommend();
        }
        
        // 设置推荐类型
        function setRecommendType(type) {
            currentRecommendType = type;
            
            // 更新按钮样式
            document.querySelectorAll('.rec-type-btn').forEach(btn => {
                btn.classList.remove('bg-blue-600');
                btn.classList.add('bg-slate-700');
            });
            const activeBtn = document.getElementById('btn-' + type);
            if (activeBtn) {
                activeBtn.classList.remove('bg-slate-700');
                activeBtn.classList.add('bg-blue-600');
            }
            
            // 更新说明
            document.getElementById('type-description').innerHTML = typeDescriptions[type] || '';
            
            // 重新加载推荐
            loadRecommend();
        }
        
        // 加载持仓
        async function refreshHoldings() {
            const res = await fetch('/api/holdings');
            const data = await res.json();
            
            if (data.success && data.data.length > 0) {
                const html = data.data.map(f => `
                    <div class="card rounded-xl p-5 glow">
                        <div class="flex justify-between items-start mb-3">
                            <div>
                                <h3 class="font-semibold text-lg">${f.name || f.code}</h3>
                                <p class="text-slate-400 text-sm">${f.code}</p>
                            </div>
                            <div class="flex gap-2">
                                <button onclick="findSimilar('${f.code}')" class="text-blue-400 hover:text-blue-300 text-sm">🔍相似</button>
                                <button onclick="deleteFund('${f.code}')" class="text-red-400 hover:text-red-300">🗑️</button>
                            </div>
                        </div>
                        <div class="space-y-2">
                            <div class="flex justify-between">
                                <span class="text-slate-400">最新净值</span>
                                <span class="font-mono">${f.current_nav?.toFixed(4) || '-'}</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-400">今日涨跌</span>
                                <span class="${f.change_pct >= 0 ? 'positive' : 'negative'} font-mono">
                                    ${f.change_pct >= 0 ? '↑' : '↓'} ${Math.abs(f.change_pct || 0).toFixed(2)}%
                                </span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-400">持仓盈亏</span>
                                <span class="${f.profit_pct >= 0 ? 'positive' : 'negative'} font-mono font-semibold">
                                    ${f.profit_pct >= 0 ? '+' : ''}${(f.profit_pct || 0).toFixed(2)}%
                                </span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-500">成本: ${f.cost || '-'} | 份额: ${f.shares || '-'}</span>
                            </div>
                        </div>
                    </div>
                `).join('');
                document.getElementById('holdings-list').innerHTML = html;
            } else {
                document.getElementById('holdings-list').innerHTML = '<p class="text-slate-400">暂无持仓，点击"添加基金"开始</p>';
            }
        }
        
        // 加载推荐
        async function loadRecommend() {
            const category = document.getElementById('category-select')?.value || 'all';
            const res = await fetch(`/api/recommend?type=${currentRecommendType}&category=${category}&limit=9`);
            const data = await res.json();
            
            // 更新候选基金数量
            document.getElementById('pool-info').textContent = `候选基金: ${data.total_candidates || '--'}只`;
            
            if (data.success && data.data && data.data.length > 0) {
                const typeLabels = {
                    'momentum': '🚀动量',
                    'contrarian': '🔄反转',
                    'low_vol': '🛡️稳健',
                    'high_sharpe': '📈高夏普',
                    'diversify': '🎨分散',
                };
                
                const html = data.data.map((f, i) => `
                    <div class="card rounded-xl p-5 ${i === 0 ? 'ring-2 ring-yellow-500' : ''} relative">
                        ${i === 0 ? '<span class="absolute top-3 right-3 text-yellow-400 text-sm">🏆 首选</span>' : ''}
                        <div class="flex justify-between items-start mb-3">
                            <div>
                                <div class="flex gap-2 mb-1">
                                    <span class="text-xs px-2 py-1 rounded bg-blue-600/30 text-blue-400">${typeLabels[currentRecommendType] || ''}</span>
                                    <span class="text-xs px-2 py-1 rounded bg-purple-600/30 text-purple-400">${f.category || ''}</span>
                                </div>
                                <h3 class="font-semibold text-lg">${f.name}</h3>
                                <p class="text-slate-400 text-sm">${f.code}</p>
                            </div>
                            <div class="text-right">
                                <div class="text-2xl font-bold ${f.score >= 70 ? 'text-green-400' : f.score >= 50 ? 'text-blue-400' : 'text-slate-400'}">${f.score}</div>
                                <div class="text-xs text-slate-500">综合评分</div>
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-3 gap-2 text-sm mb-3">
                            <div class="bg-slate-700/50 rounded p-2 text-center">
                                <span class="text-slate-400 text-xs">90日涨跌</span>
                                <p class="${f.momentum_90d >= 0 ? 'positive' : 'negative'} font-mono font-semibold">${f.momentum_90d >= 0 ? '+' : ''}${f.momentum_90d?.toFixed(1) || 0}%</p>
                            </div>
                            <div class="bg-slate-700/50 rounded p-2 text-center">
                                <span class="text-slate-400 text-xs">夏普比率</span>
                                <p class="font-mono font-semibold">${f.sharpe_ratio || 0}</p>
                            </div>
                            <div class="bg-slate-700/50 rounded p-2 text-center">
                                <span class="text-slate-400 text-xs">波动率</span>
                                <p class="font-mono">${f.volatility || 0}%</p>
                            </div>
                        </div>
                        
                        <div class="flex gap-2">
                            <button onclick="addToPortfolio('${f.code}', '${f.name}')" class="flex-1 bg-blue-600 hover:bg-blue-700 py-2 rounded-lg text-sm transition">
                                ➕ 添加
                            </button>
                            <button onclick="findSimilar('${f.code}')" class="px-3 py-2 bg-slate-700 hover:bg-slate-600 rounded-lg text-sm transition">
                                🔍相似
                            </button>
                        </div>
                    </div>
                `).join('');
                document.getElementById('recommend-list').innerHTML = html;
            } else {
                document.getElementById('recommend-list').innerHTML = '<p class="text-slate-400 col-span-full text-center py-8">暂无可推荐基金，可能数据不足</p>';
            }
        }
        
        // 查找相似基金
        async function findSimilar(code) {
            const res = await fetch(`/api/recommend/similar?code=${code}&limit=5`);
            const data = await res.json();
            
            if (data.success && data.data && data.data.length > 0) {
                let html = `<div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" onclick="this.remove()">
                    <div class="bg-slate-800 rounded-xl p-6 max-w-md w-full mx-4" onclick="event.stopPropagation()">
                        <h3 class="text-lg font-semibold mb-4">与 ${data.target_code} 相似的基金</h3>
                        <div class="space-y-3">`;
                
                data.data.forEach(f => {
                    html += `
                        <div class="flex justify-between items-center p-3 bg-slate-700/50 rounded-lg">
                            <div>
                                <p class="font-semibold">${f.name}</p>
                                <p class="text-slate-400 text-sm">${f.code}</p>
                            </div>
                            <div class="text-right">
                                <p class="text-blue-400 font-semibold">${f.similarity}%</p>
                                <p class="text-slate-500 text-xs">相似度</p>
                            </div>
                        </div>
                    `;
                });
                
                html += `</div>
                        <button onclick="this.closest('.fixed').remove()" class="w-full mt-4 py-2 bg-slate-700 hover:bg-slate-600 rounded-lg transition">关闭</button>
                    </div>
                </div>`;
                
                document.body.insertAdjacentHTML('beforeend', html);
            } else {
                alert('未找到相似基金');
            }
        }
        
        // 添加到组合（快速添加到持仓）
        async function addToPortfolio(code, name) {
            if (confirm(`确定要将 ${name} (${code}) 添加到持仓吗？`)) {
                const res = await fetch('/api/holdings', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        code: code,
                        name: name,
                        shares: 0,
                        cost: 0,
                        note: '智能推荐添加'
                    })
                });
                
                const data = await res.json();
                if (data.success) {
                    alert('添加成功！');
                    refreshHoldings();
                } else {
                    alert(data.error || '添加失败');
                }
            }
        }

        // 添加基金
        document.getElementById('add-form').onsubmit = async (e) => {
            e.preventDefault();
            const code = document.getElementById('fund-code').value.trim();
            
            if (!code) {
                alert('请输入基金代码');
                return;
            }
            
            const res = await fetch('/api/holdings', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    code: code,
                    name: document.getElementById('fund-name').value,
                    shares: parseFloat(document.getElementById('fund-shares').value) || 0,
                    cost: parseFloat(document.getElementById('fund-cost').value) || 0,
                    note: document.getElementById('fund-note').value
                })
            });
            
            const data = await res.json();
            if (data.success) {
                alert('添加成功！');
                document.getElementById('add-form').reset();
                showTab('holdings');
            } else {
                alert(data.error || '添加失败');
            }
        };

        // 自动获取基金名称
        document.getElementById('fund-code').onblur = async (e) => {
            const code = e.target.value.trim();
            if (code && code.length === 6) {
                const res = await fetch(`/api/fund/${code}`);
                const data = await res.json();
                if (data.success && data.quote) {
                    document.getElementById('fund-name').value = data.quote.name;
                }
            }
        };

        // 删除基金
        async function deleteFund(code) {
            if (!confirm('确定要删除这只基金吗？')) return;
            
            const res = await fetch(`/api/holdings/${code}`, {method: 'DELETE'});
            const data = await res.json();
            if (data.success) {
                refreshHoldings();
            }
        }

        // 初始加载
        refreshHoldings();
    </script>
</body>
</html>
