<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FundQuant - 基金量化助手</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .positive { color: #ef4444; }
        .negative { color: #22c55e; }
        .card { background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); }
        .glow { box-shadow: 0 0 20px rgba(59, 130, 246, 0.3); }
        .ai-badge { animation: pulse 2s infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }
        .tab-btn.active { background-color: #3b82f6; }
    </style>
</head>
<body class="bg-slate-900 text-white min-h-screen">
    <nav class="bg-slate-800 border-b border-slate-700 px-6 py-4">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <h1 class="text-xl sm:text-2xl font-bold bg-gradient-to-r from-blue-400 to-purple-500 bg-clip-text text-transparent">
                📈 FundQuant
            </h1>
            <div class="flex gap-2 sm:gap-4 text-sm sm:text-base">
                <button id="tab-btn-holdings" class="tab-btn px-2 sm:px-4 py-2 rounded-lg hover:bg-slate-700 transition active">📊 持仓</button>
                <button id="tab-btn-recommend" class="tab-btn px-2 sm:px-4 py-2 rounded-lg hover:bg-slate-700 transition">🏆 推荐</button>
                <button id="tab-btn-add" class="tab-btn px-2 sm:px-4 py-2 rounded-lg hover:bg-slate-700 transition">➕ 添加</button>
            </div>
        </div>
    </nav>

    <main class="max-w-6xl mx-auto p-4 sm:p-6">
        <!-- 持仓 Tab -->
        <div id="tab-holdings" class="tab-content">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
                <h2 class="text-xl font-semibold">我的持仓</h2>
                <div class="flex gap-2">
                    <button id="ai-analyze-all-btn" class="px-3 sm:px-4 py-2 bg-purple-600 hover:bg-purple-700 rounded-lg transition flex items-center gap-2 text-sm">
                        🤖 AI分析
                    </button>
                    <button id="refresh-btn" class="px-3 sm:px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg transition text-sm">
                        🔄 刷新
                    </button>
                </div>
            </div>
            <div id="holdings-list" class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
                <div class="text-slate-400 col-span-full text-center py-8">加载中...</div>
            </div>
            
            <div id="ai-report-area" class="mt-6 hidden">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-lg font-semibold flex items-center gap-2">
                        <span class="ai-badge">🤖</span> AI分析报告
                    </h3>
                    <button id="clear-reports-btn" class="text-slate-400 hover:text-white text-sm">🗑️ 清除</button>
                </div>
                <div id="ai-reports-container" class="space-y-4"></div>
            </div>
            
            <div id="error-area" class="mt-6 hidden">
                <div class="bg-red-900/30 border border-red-500/50 rounded-xl p-4">
                    <h3 class="text-red-400 font-semibold mb-2">❌ 错误</h3>
                    <pre id="error-content" class="text-red-300 text-sm whitespace-pre-wrap"></pre>
                </div>
            </div>
        </div>

        <!-- 推荐 Tab -->
        <div id="tab-recommend" class="tab-content hidden">
            <h2 class="text-xl font-semibold mb-6">🎯 智能基金推荐</h2>
            <div class="bg-slate-800 rounded-xl p-4 mb-6">
                <div class="flex flex-wrap gap-2 mb-4">
                    <button id="btn-momentum" class="rec-type-btn px-3 py-2 rounded-lg bg-blue-600 transition text-sm">🚀 动量型</button>
                    <button id="btn-contrarian" class="rec-type-btn px-3 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 transition text-sm">🔄 反转型</button>
                    <button id="btn-low_vol" class="rec-type-btn px-3 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 transition text-sm">🛡️ 稳健型</button>
                    <button id="btn-high_sharpe" class="rec-type-btn px-3 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 transition text-sm">📈 高夏普</button>
                    <button id="btn-diversify" class="rec-type-btn px-3 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 transition text-sm">🎨 分散型</button>
                </div>
                <div id="type-description" class="text-slate-400 text-sm mb-4"><strong>🚀 动量型</strong>：追涨强势基金，近90日涨幅高，适合趋势行情</div>
                <div class="flex flex-wrap gap-2">
                    <select id="category-select" class="bg-slate-700 rounded-lg px-3 py-2 text-sm">
                        <option value="all">全部基金</option>
                        <option value="broad_index">宽基指数</option>
                        <option value="industry">行业主题</option>
                        <option value="bond">债券稳健</option>
                        <option value="qdii">海外QDII</option>
                    </select>
                    <span class="text-slate-500 text-sm self-center" id="pool-info">候选基金: --</span>
                </div>
            </div>
            <div id="recommend-list" class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
                <div class="text-slate-400 col-span-full text-center py-8">加载中...</div>
            </div>
        </div>

        <!-- 添加基金 Tab -->
        <div id="tab-add" class="tab-content hidden">
            <h2 class="text-xl font-semibold mb-6">添加基金</h2>
            <form id="add-form" class="max-w-md bg-slate-800 rounded-xl p-6 space-y-4">
                <div>
                    <label class="block text-sm text-slate-400 mb-1">基金代码</label>
                    <input type="text" id="fund-code" placeholder="如: 510300" class="w-full bg-slate-700 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-sm text-slate-400 mb-1">基金名称 (自动获取)</label>
                    <input type="text" id="fund-name" placeholder="自动获取" readonly class="w-full bg-slate-700 rounded-lg px-4 py-2 opacity-70">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm text-slate-400 mb-1">持有份额</label>
                        <input type="number" id="fund-shares" placeholder="0" class="w-full bg-slate-700 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    <div>
                        <label class="block text-sm text-slate-400 mb-1">买入成本</label>
                        <input type="number" step="0.001" id="fund-cost" placeholder="0.00" class="w-full bg-slate-700 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                </div>
                <div>
                    <label class="block text-sm text-slate-400 mb-1">备注</label>
                    <input type="text" id="fund-note" placeholder="如: 主要仓位" class="w-full bg-slate-700 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 py-3 rounded-lg font-semibold transition">✅ 添加持仓</button>
            </form>
        </div>
    </main>

    <script>
        let currentRecommendType = 'momentum';
        let currentHoldings = [];
        
        const typeDescriptions = {
            'momentum': '<strong>🚀 动量型</strong>：追涨强势基金，近90日涨幅高，适合趋势行情',
            'contrarian': '<strong>🔄 反转型</strong>：超跌反弹机会，近期跌幅大但基本面稳健',
            'low_vol': '<strong>🛡️ 稳健型</strong>：低波动、低回撤，追求稳定收益',
            'high_sharpe': '<strong>📈 高夏普</strong>：风险调整收益最优，性价比最高',
            'diversify': '<strong>🎨 分散型</strong>：综合评分高，可作为组合配置补充',
        };
        
        function showTab(tab) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
            const targetTab = document.getElementById('tab-' + tab);
            const targetBtn = document.getElementById('tab-btn-' + tab);
            if (targetTab) targetTab.classList.remove('hidden');
            if (targetBtn) targetBtn.classList.add('active');
            
            if (tab === 'holdings') refreshHoldings();
            if (tab === 'recommend') loadRecommend();
        }
        
        function setRecommendType(type) {
            currentRecommendType = type;
            document.querySelectorAll('.rec-type-btn').forEach(btn => {
                btn.classList.remove('bg-blue-600');
                btn.classList.add('bg-slate-700');
            });
            const activeBtn = document.getElementById('btn-' + type);
            if (activeBtn) {
                activeBtn.classList.remove('bg-slate-700');
                activeBtn.classList.add('bg-blue-600');
            }
            const desc = document.getElementById('type-description');
            if (desc) desc.innerHTML = typeDescriptions[type] || '';
            loadRecommend();
        }
        
        function escapeHtml(str) {
            if (!str) return '';
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }
        
        function showError(message) {
            const errorArea = document.getElementById('error-area');
            const errorContent = document.getElementById('error-content');
            if (errorContent) errorContent.textContent = message;
            if (errorArea) errorArea.classList.remove('hidden');
            setTimeout(function() { if (errorArea) errorArea.classList.add('hidden'); }, 5000);
        }
        
        async function refreshHoldings() {
            try {
                const res = await fetch('/api/holdings');
                const data = await res.json();
                const container = document.getElementById('holdings-list');
                
                if (data.success && data.data && data.data.length > 0) {
                    currentHoldings = data.data;
                    let html = '';
                    data.data.forEach(function(f) {
                        const name = escapeHtml(f.name || f.code);
                        const code = escapeHtml(f.code);
                        const changeClass = (f.change_pct >= 0) ? 'positive' : 'negative';
                        const changeSign = (f.change_pct >= 0) ? '↑' : '↓';
                        const profitClass = (f.profit_pct >= 0) ? 'positive' : 'negative';
                        const profitSign = (f.profit_pct >= 0) ? '+' : '';
                        
                        html += '<div class="card rounded-xl p-4 sm:p-5 glow"><div class="flex justify-between items-start mb-3"><div><h3 class="font-semibold text-base sm:text-lg">' + name + '</h3><p class="text-slate-400 text-sm">' + code + '</p></div><div class="flex gap-2"><button class="ai-btn text-purple-400 hover:text-purple-300 text-xs sm:text-sm px-2 py-1" data-code="' + code + '" data-name="' + name + '">🤖 AI</button><button class="similar-btn text-blue-400 hover:text-blue-300 text-xs sm:text-sm px-2 py-1" data-code="' + code + '">🔍</button><button class="delete-btn text-red-400 hover:text-red-300 text-xs sm:text-sm px-2 py-1" data-code="' + code + '">🗑️</button></div></div><div class="space-y-1 sm:space-y-2 text-sm"><div class="flex justify-between"><span class="text-slate-400">最新净值</span><span class="font-mono">' + (f.current_nav ? f.current_nav.toFixed(4) : '-') + '</span></div><div class="flex justify-between"><span class="text-slate-400">今日涨跌</span><span class="' + changeClass + ' font-mono">' + changeSign + ' ' + Math.abs(f.change_pct || 0).toFixed(2) + '%</span></div><div class="flex justify-between"><span class="text-slate-400">持仓盈亏</span><span class="' + profitClass + ' font-mono font-semibold">' + profitSign + (f.profit_pct || 0).toFixed(2) + '%</span></div><div class="flex justify-between text-xs text-slate-500"><span>成本: ' + (f.cost || '-') + ' | 份额: ' + (f.shares || '-') + '</span></div></div></div>';
                    });
                    if (container) container.innerHTML = html;
                } else {
                    if (container) container.innerHTML = '<p class="text-slate-400 col-span-full text-center py-8">暂无持仓，点击"添加基金"开始</p>';
                }
            } catch (e) {
                console.error('获取持仓失败:', e);
                showError('获取持仓失败: ' + e.message);
            }
        }
        
        async function analyzeSingleFund(code, name) {
            const btn = event.target;
            if (!btn) return;
            const originalText = btn.innerHTML;
            btn.innerHTML = '⏳';
            btn.disabled = true;
            
            const reportArea = document.getElementById('ai-report-area');
            if (reportArea) reportArea.classList.remove('hidden');
            
            try {
                const res = await fetch('/api/analyze/' + code);
                const data = await res.json();
                if (data.success) {
                    showAIReport(data.data, code, name);
                } else {
                    showError('分析失败: ' + (data.error || '未知错误'));
                }
            } catch (e) {
                showError('网络请求失败: ' + e.message);
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }
        
        async function analyzeAllFunds() {
            const btn = document.getElementById('ai-analyze-all-btn');
            if (!btn) return;
            btn.innerHTML = '⏳ 分析中...';
            btn.disabled = true;
            
            const reportArea = document.getElementById('ai-report-area');
            const container = document.getElementById('ai-reports-container');
            if (reportArea) reportArea.classList.remove('hidden');
            if (container) container.innerHTML = '<p class="text-slate-400">正在分析，请稍候...</p>';
            
            try {
                if (currentHoldings.length === 0) {
                    const res = await fetch('/api/holdings');
                    const data = await res.json();
                    if (data.success && data.data) {
                        currentHoldings = data.data;
                    }
                }
                
                if (currentHoldings.length === 0) {
                    showError('请先添加持仓');
                    btn.innerHTML = '🤖 AI分析';
                    btn.disabled = false;
                    return;
                }
                
                if (container) container.innerHTML = '';
                let successCount = 0, failCount = 0;
                
                for (let i = 0; i < currentHoldings.length; i++) {
                    const fund = currentHoldings[i];
                    try {
                        const res = await fetch('/api/analyze/' + fund.code);
                        const result = await res.json();
                        if (result.success) {
                            showAIReport(result.data, fund.code, fund.name || fund.code);
                            successCount++;
                        } else {
                            failCount++;
                        }
                    } catch (e) {
                        failCount++;
                    }
                    await new Promise(function(r) { setTimeout(r, 500); });
                }
                
                if (failCount > 0 && container) {
                    container.innerHTML += '<p class="text-yellow-400 text-sm mt-4">⚠️ 完成: 成功' + successCount + '只, 失败' + failCount + '只</p>';
                }
            } catch (e) {
                showError('分析失败: ' + e.message);
            } finally {
                btn.innerHTML = '🤖 AI分析';
                btn.disabled = false;
            }
        }
        
        function showAIReport(data, code, name) {
            const container = document.getElementById('ai-reports-container');
            if (!container) return;
            
            const analysis = data.analysis || {};
            const aiReport = data.ai_report || {};
            const displayName = escapeHtml(name || code);
            const safeCode = escapeHtml(code);
            
            let scoreClass = 'text-slate-400';
            if (aiReport.score >= 70) scoreClass = 'text-green-400';
            else if (aiReport.score >= 50) scoreClass = 'text-blue-400';
            
            const momClass = (analysis.momentum_90d >= 0) ? 'positive' : 'negative';
            const momSign = (analysis.momentum_90d >= 0) ? '+' : '';
            
            let html = '<div class="bg-slate-800 rounded-xl p-4 sm:p-5 border border-purple-500/30">';
            html += '<div class="flex justify-between items-start mb-4"><div><h4 class="font-semibold text-base sm:text-lg">' + displayName + '</h4><p class="text-slate-400 text-sm">' + safeCode + '</p></div>';
            if (aiReport.score) {
                html += '<div class="text-right"><div class="text-2xl sm:text-3xl font-bold ' + scoreClass + '">' + aiReport.score + '</div><div class="text-xs text-slate-500">AI评分</div></div>';
            }
            html += '</div>';
            
            html += '<div class="grid grid-cols-4 gap-2 mb-4 text-xs sm:text-sm"><div class="bg-slate-700/50 rounded p-2 text-center"><span class="text-slate-400">90日涨跌</span><p class="' + momClass + ' font-mono font-semibold">' + momSign + ((analysis.momentum_90d || 0)).toFixed(1) + '%</p></div><div class="bg-slate-700/50 rounded p-2 text-center"><span class="text-slate-400">夏普比率</span><p class="font-mono font-semibold">' + ((analysis.sharpe_ratio || 0)).toFixed(2) + '</p></div><div class="bg-slate-700/50 rounded p-2 text-center"><span class="text-slate-400">波动率</span><p class="font-mono">' + ((analysis.volatility || 0)).toFixed(1) + '%</p></div><div class="bg-slate-700/50 rounded p-2 text-center"><span class="text-slate-400">最大回撤</span><p class="font-mono text-red-400">-' + ((analysis.max_drawdown || 0)).toFixed(1) + '%</p></div></div>';
            
            if (aiReport.recommendation) {
                html += '<div class="mb-3 p-2 bg-slate-700/30 rounded"><span class="text-purple-400 font-semibold">' + escapeHtml(aiReport.recommendation) + '</span></div>';
            }
            
            if (aiReport.report) {
                html += '<div class="border-t border-slate-700 pt-4"><h5 class="text-sm font-semibold text-purple-400 mb-2">📝 AI分析报告</h5><div class="text-slate-300 text-sm whitespace-pre-wrap leading-relaxed">' + escapeHtml(aiReport.report) + '</div></div>';
            }
            
            html += '</div>';
            container.insertAdjacentHTML('beforeend', html);
        }
        
        function clearAIReports() {
            const container = document.getElementById('ai-reports-container');
            const reportArea = document.getElementById('ai-report-area');
            if (container) container.innerHTML = '';
            if (reportArea) reportArea.classList.add('hidden');
        }
        
        async function loadRecommend() {
            const category = document.getElementById('category-select');
            const cat = category ? category.value : 'all';
            try {
                const res = await fetch('/api/recommend?type=' + currentRecommendType + '&category=' + cat + '&limit=9');
                const data = await res.json();
                const poolInfo = document.getElementById('pool-info');
                if (poolInfo) poolInfo.textContent = '候选基金: ' + (data.total_candidates || '--') + '只';
                
                const container = document.getElementById('recommend-list');
                if (!container) return;
                
                if (data.success && data.data && data.data.length > 0) {
                    const typeLabels = {
                        'momentum': '🚀动量', 'contrarian': '🔄反转', 'low_vol': '🛡️稳健',
                        'high_sharpe': '📈高夏普', 'diversify': '🎨分散',
                    };
                    
                    let html = '';
                    data.data.forEach(function(f, i) {
                        const name = escapeHtml(f.name || '');
                        const code = escapeHtml(f.code || '');
                        let scoreClass = (f.score >= 70) ? 'text-green-400' : (f.score >= 50) ? 'text-blue-400' : 'text-slate-400';
                        const momClass = (f.momentum_90d >= 0) ? 'positive' : 'negative';
                        const momSign = (f.momentum_90d >= 0) ? '+' : '';
                        const typeLabel = typeLabels[currentRecommendType] || '';
                        const catLabel = escapeHtml(f.category || '');
                        
                        html += '<div class="card rounded-xl p-4 sm:p-5 ' + (i === 0 ? 'ring-2 ring-yellow-500' : '') + ' relative">';
                        if (i === 0) html += '<span class="absolute top-2 sm:top-3 right-2 sm:right-3 text-yellow-400 text-xs">🏆 首选</span>';
                        html += '<div class="flex justify-between items-start mb-3"><div><div class="flex gap-2 mb-1 flex-wrap"><span class="text-xs px-2 py-1 rounded bg-blue-600/30 text-blue-400">' + typeLabel + '</span><span class="text-xs px-2 py-1 rounded bg-purple-600/30 text-purple-400">' + catLabel + '</span></div><h3 class="font-semibold text-base sm:text-lg">' + name + '</h3><p class="text-slate-400 text-sm">' + code + '</p></div><div class="text-right"><div class="text-xl sm:text-2xl font-bold ' + scoreClass + '">' + f.score + '</div><div class="text-xs text-slate-500">综合评分</div></div></div>';
                        html += '<div class="grid grid-cols-3 gap-2 text-xs sm:text-sm mb-3"><div class="bg-slate-700/50 rounded p-2 text-center"><span class="text-slate-400">90日涨跌</span><p class="' + momClass + ' font-mono font-semibold">' + momSign + (f.momentum_90d || 0).toFixed(1) + '%</p></div><div class="bg-slate-700/50 rounded p-2 text-center"><span class="text-slate-400">夏普比率</span><p class="font-mono font-semibold">' + ((f.sharpe_ratio || 0)).toFixed(2) + '</p></div><div class="bg-slate-700/50 rounded p-2 text-center"><span class="text-slate-400">波动率</span><p class="font-mono">' + ((f.volatility || 0)).toFixed(1) + '%</p></div></div>';
                        html += '<div class="flex gap-2"><button class="add-btn flex-1 bg-blue-600 hover:bg-blue-700 py-2 rounded-lg text-sm transition" data-code="' + code + '" data-name="' + name + '">➕ 添加</button><button class="similar-btn px-2 sm:px-3 py-2 bg-slate-700 hover:bg-slate-600 rounded-lg text-sm transition" data-code="' + code + '">🔍相似</button></div></div>';
                    });
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<p class="text-slate-400 col-span-full text-center py-8">暂无可推荐基金，可能数据不足</p>';
                }
            } catch (e) {
                console.error('加载推荐失败:', e);
            }
        }
        
        async function findSimilar(code) {
            try {
                const res = await fetch('/api/recommend/similar?code=' + code + '&limit=5');
                const data = await res.json();
                if (data.success && data.data && data.data.length > 0) {
                    let html = '<div id="similar-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4"><div class="bg-slate-800 rounded-xl p-4 sm:p-6 max-w-md w-full"><h3 class="text-lg font-semibold mb-4">🔍 与 ' + escapeHtml(code) + ' 相似的基金</h3><div class="space-y-3 max-h-80 overflow-y-auto">';
                    data.data.forEach(function(f) {
                        html += '<div class="flex justify-between items-center p-3 bg-slate-700/50 rounded-lg"><div><p class="font-semibold text-sm sm:text-base">' + escapeHtml(f.name || f.code) + '</p><p class="text-slate-400 text-xs sm:text-sm">' + escapeHtml(f.code) + '</p></div><div class="text-right"><p class="text-blue-400 font-semibold">' + f.similarity + '%</p><p class="text-slate-500 text-xs">相似度</p></div></div>';
                    });
                    html += '</div><button id="close-modal-btn" class="w-full mt-4 py-2 bg-slate-700 hover:bg-slate-600 rounded-lg transition">关闭</button></div></div>';
                    document.body.insertAdjacentHTML('beforeend', html);
                    
                    const closeBtn = document.getElementById('close-modal-btn');
                    const modal = document.getElementById('similar-modal');
                    if (closeBtn) closeBtn.onclick = function() { if (modal) modal.remove(); };
                    if (modal) modal.onclick = function(e) { if (e.target === modal) modal.remove(); };
                } else {
                    showError('未找到相似基金');
                }
            } catch (e) {
                showError('查找失败: ' + e.message);
            }
        }
        
        async function addToPortfolio(code, name) {
            if (confirm('确定要将 ' + name + ' (' + code + ') 添加到持仓吗？')) {
                try {
                    const res = await fetch('/api/holdings', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({code: code, name: name, shares: 0, cost: 0, note: '智能推荐添加'})
                    });
                    const data = await res.json();
                    if (data.success) {
                        alert('添加成功！');
                        currentHoldings = [];
                        refreshHoldings();
                        showTab('holdings');
                    } else {
                        alert(data.error || '添加失败');
                    }
                } catch (e) {
                    alert('请求失败: ' + e.message);
                }
            }
        }
        
        async function deleteFund(code) {
            if (!confirm('确定要删除这只基金吗？')) return;
            try {
                const res = await fetch('/api/holdings/' + code, {method: 'DELETE'});
                const data = await res.json();
                if (data.success) {
                    currentHoldings = [];
                    refreshHoldings();
                }
            } catch (e) {
                alert('删除失败: ' + e.message);
            }
        }
        
        // 事件绑定
        document.getElementById('tab-btn-holdings').onclick = function() { showTab('holdings'); };
        document.getElementById('tab-btn-recommend').onclick = function() { showTab('recommend'); };
        document.getElementById('tab-btn-add').onclick = function() { showTab('add'); };
        document.getElementById('ai-analyze-all-btn').onclick = analyzeAllFunds;
        document.getElementById('refresh-btn').onclick = refreshHoldings;
        document.getElementById('clear-reports-btn').onclick = clearAIReports;
        document.getElementById('btn-momentum').onclick = function() { setRecommendType('momentum'); };
        document.getElementById('btn-contrarian').onclick = function() { setRecommendType('contrarian'); };
        document.getElementById('btn-low_vol').onclick = function() { setRecommendType('low_vol'); };
        document.getElementById('btn-high_sharpe').onclick = function() { setRecommendType('high_sharpe'); };
        document.getElementById('btn-diversify').onclick = function() { setRecommendType('diversify'); };
        document.getElementById('category-select').onchange = loadRecommend;
        
        // 统一事件委托
        document.addEventListener('click', function(e) {
            const target = e.target;
            if (!target) return;
            
            // AI分析单个基金
            if (target.classList.contains('ai-btn')) {
                analyzeSingleFund(target.dataset.code, target.dataset.name);
            }
            // 相似基金
            else if (target.classList.contains('similar-btn')) {
                findSimilar(target.dataset.code);
            }
            // 删除基金
            else if (target.classList.contains('delete-btn')) {
                deleteFund(target.dataset.code);
            }
            // 添加到持仓
            else if (target.classList.contains('add-btn')) {
                addToPortfolio(target.dataset.code, target.dataset.name);
            }
        });
        
        // 添加基金表单
        document.getElementById('add-form').onsubmit = function(e) {
            e.preventDefault();
            const code = document.getElementById('fund-code').value.trim();
            if (!code) { alert('请输入基金代码'); return; }
            
            fetch('/api/holdings', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    code: code,
                    name: document.getElementById('fund-name').value,
                    shares: parseFloat(document.getElementById('fund-shares').value) || 0,
                    cost: parseFloat(document.getElementById('fund-cost').value) || 0,
                    note: document.getElementById('fund-note').value
                })
            }).then(function(res) { return res.json(); })
              .then(function(data) {
                  if (data.success) {
                      alert('添加成功！');
                      document.getElementById('add-form').reset();
                      currentHoldings = [];
                      showTab('holdings');
                  } else {
                      alert(data.error || '添加失败');
                  }
              })
              .catch(function(e) { alert('请求失败: ' + e.message); });
        };
        
        // 基金代码失焦获取名称
        document.getElementById('fund-code').onblur = function(e) {
            const code = e.target.value.trim();
            if (code && code.length === 6) {
                fetch('/api/fund/' + code)
                    .then(function(res) { return res.json(); })
                    .then(function(data) {
                        if (data.success && data.quote) {
                            document.getElementById('fund-name').value = data.quote.name;
                        }
                    })
                    .catch(function() {});
            }
        };
        
        // 初始加载
        refreshHoldings();
    </script>
</body>
</html>