<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FundQuant - 基金量化助手</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; background: #f5f7fa; color: #333; }
        .container { max-width: 1400px; margin: 0 auto; padding: 20px; }
        header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 30px 0; margin-bottom: 30px; border-radius: 0 0 20px 20px; }
        header h1 { text-align: center; font-size: 2.5em; }
        header p { text-align: center; opacity: 0.9; margin-top: 10px; }
        .tabs { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
        .tab { padding: 12px 24px; background: white; border: none; border-radius: 10px; cursor: pointer; font-size: 16px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); transition: all 0.3s; }
        .tab:hover { transform: translateY(-2px); }
        .tab.active { background: #667eea; color: white; }
        .card { background: white; border-radius: 15px; padding: 20px; margin-bottom: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .fund-card { background: white; border-radius: 15px; padding: 20px; margin-bottom: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .fund-card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; padding-bottom: 15px; border-bottom: 1px solid #eee; }
        .fund-card-header h3 { color: #333; font-size: 1.1em; }
        .fund-card-header .code { color: #999; font-size: 0.9em; }
        .fund-card-actions { display: flex; gap: 10px; margin-top: 15px; flex-wrap: wrap; }
        .fund-card-body { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 15px; }
        .fund-stat { text-align: center; padding: 10px; background: #f8f9fa; border-radius: 8px; }
        .fund-stat .label { color: #666; font-size: 0.85em; margin-bottom: 5px; }
        .fund-stat .value { font-size: 1.2em; font-weight: bold; font-family: monospace; }
        .tag { font-size: 0.75em; padding: 2px 6px; border-radius: 4px; margin-left: 5px; }
        .tag-estimate { background: #fff3cd; color: #856404; }
        .tag-actual { background: #d4edda; color: #155724; }
        .up { color: #e74c3c; }
        .down { color: #27ae60; }
        .profit { color: #e74c3c; font-weight: bold; }
        .loss { color: #27ae60; font-weight: bold; }
        .btn { padding: 10px 20px; background: #667eea; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 14px; }
        .btn:hover { background: #764ba2; }
        .btn-refresh { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .btn-refresh:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4); }
        .btn-ai { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }
        .btn-ai:hover { box-shadow: 0 4px 15px rgba(245, 87, 108, 0.4); }
        .btn:disabled { opacity: 0.6; cursor: not-allowed; }
        .loading { text-align: center; padding: 40px; color: #999; }
        .spinner { width: 40px; height: 40px; border: 4px solid #f3f3f3; border-top: 4px solid #667eea; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 15px; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .fund-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 15px; }
        
        /* AI分析弹窗 */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center; }
        .modal.show { display: flex; }
        .modal-content { background: white; border-radius: 15px; padding: 30px; max-width: 600px; width: 90%; max-height: 80vh; overflow-y: auto; position: relative; }
        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 15px; border-bottom: 2px solid #eee; }
        .modal-title { font-size: 1.3em; font-weight: bold; color: #333; }
        .modal-close { background: none; border: none; font-size: 1.5em; cursor: pointer; color: #999; }
        .modal-close:hover { color: #333; }
        
        /* AI报告样式 */
        .ai-report { padding: 20px; }
        .ai-section { margin-bottom: 20px; }
        .ai-section-title { font-weight: bold; color: #667eea; margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
        .ai-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
        .ai-metric { text-align: center; padding: 10px; background: #f8f9fa; border-radius: 8px; }
        .ai-metric .label { font-size: 0.85em; color: #666; }
        .ai-metric .value { font-size: 1.1em; font-weight: bold; margin-top: 5px; }
        
        .ai-score { text-align: center; padding: 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 10px; color: white; margin-bottom: 20px; }
        .ai-score .score-value { font-size: 2.5em; font-weight: bold; }
        .ai-score .score-label { font-size: 1.1em; margin-top: 5px; }
        .ai-score .score-bar { width: 100%; height: 8px; background: rgba(255,255,255,0.3); border-radius: 4px; margin-top: 10px; overflow: hidden; }
        .ai-score .score-bar-inner { height: 100%; background: white; border-radius: 4px; transition: width 0.5s; }
        
        .ai-advice { padding: 15px; background: #f8f9fa; border-radius: 10px; border-left: 4px solid #667eea; }
        .ai-advice .advice-title { font-weight: bold; font-size: 1.1em; margin-bottom: 10px; }
        .ai-advice.buy { border-left-color: #27ae60; background: #e8f8f0; }
        .ai-advice.hold { border-left-color: #667eea; background: #f0f3ff; }
        .ai-advice.sell { border-left-color: #e74c3c; background: #fdf2f2; }
        
        .ai-text { line-height: 1.8; color: #555; }
        .ai-risk { padding: 10px 15px; background: #fff3cd; border-radius: 8px; color: #856404; font-size: 0.9em; }
        
        /* 推荐卡片样式 */
        .rec-section { margin-bottom: 30px; }
        .rec-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
        .rec-title { font-size: 1.3em; font-weight: bold; display: flex; align-items: center; gap: 10px; }
        .hot-sectors { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px; }
        .sector-tag { background: linear-gradient(135deg, #ff6b6b 0%, #ff8e53 100%); color: white; padding: 8px 16px; border-radius: 20px; font-size: 0.9em; }
        .update-time { text-align: right; color: #999; font-size: 0.85em; margin-bottom: 15px; display: flex; justify-content: space-between; align-items: center; }
        
        /* Toast提示 */
        .toast { position: fixed; top: 20px; left: 50%; transform: translateX(-50%); background: #333; color: white; padding: 15px 30px; border-radius: 10px; z-index: 1001; opacity: 0; transition: opacity 0.3s; }
        .toast.show { opacity: 1; }
        .toast.success { background: #27ae60; }
        .toast.error { background: #e74c3c; }
        
        @media (max-width: 768px) { .fund-card-body { grid-template-columns: repeat(2, 1fr); } .ai-metrics { grid-template-columns: repeat(2, 1fr); } }
    </style>
</head>
<body>
    <div class="toast" id="toast"></div>
    
    <!-- AI分析弹窗 -->
    <div class="modal" id="aiModal">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title">🤖 AI 分析报告</div>
                <button class="modal-close" onclick="closeModal()">&times;</button>
            </div>
            <div id="aiReportContent">
                <div class="loading">
                    <div class="spinner"></div>
                    <p>正在分析，请稍候...</p>
                </div>
            </div>
        </div>
    </div>
    
    <header>
        <h1>FundQuant</h1>
        <p>基金量化助手 - 智能分析 · 精准推荐</p>
    </header>
    
    <div class="container">
        <div class="tabs">
            <button class="tab active" id="tab-holdings">我的持仓</button>
            <button class="tab" id="tab-recommend">智能推荐</button>
        </div>
        <div class="update-time" id="update-info">
            <span id="update-time"></span>
            <button class="btn btn-refresh" id="btn-refresh" onclick="refreshRecommendations()">🔄 立即更新</button>
        </div>
        <div id="content"><div class="loading"><div class="spinner"></div><p>加载中...</p></div></div>
    </div>
    
    <script>
        let currentTab = "holdings";
        let isRefreshing = false;
        let currentFund = null;
        
        document.getElementById("tab-holdings").addEventListener("click", () => switchTab("holdings"));
        document.getElementById("tab-recommend").addEventListener("click", () => switchTab("recommend"));
        
        function switchTab(tab) { 
            currentTab = tab; 
            document.querySelectorAll(".tab").forEach(t => t.classList.remove("active")); 
            document.getElementById("tab-" + tab).classList.add("active"); 
            document.getElementById("update-info").style.display = tab === "recommend" ? "flex" : "none";
            loadData(); 
        }
        
        async function loadData() {
            const c = document.getElementById("content");
            c.innerHTML = "<div class=loading><div class=spinner></div><p>加载中...</p></div>";
            
            if (currentTab === "holdings") { 
                const r = await fetch("/api/quotes"); 
                renderHoldings(await r.json()); 
            } else { 
                const r = await fetch("/api/recommendations"); 
                if (r.ok) { renderRecommend(await r.json()); } 
                else { c.innerHTML = "<div class=card><p>暂无推荐数据</p><button class=btn onclick=loadData()>刷新</button></div>"; }
            }
        }
        
        function showToast(message, type = 'info') {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.className = 'toast show ' + type;
            setTimeout(() => toast.classList.remove('show'), 3000);
        }
        
        async function refreshRecommendations() {
            if (isRefreshing) return;
            
            const btn = document.getElementById('btn-refresh');
            btn.disabled = true;
            btn.innerHTML = '⏳ 更新中...';
            isRefreshing = true;
            
            try {
                const r = await fetch('/api/recommendations/refresh', { method: 'POST' });
                const data = await r.json();
                
                if (data.status === 'success') {
                    showToast('✅ ' + data.message, 'success');
                    setTimeout(() => loadData(), 2000);
                } else {
                    showToast('❌ 更新失败', 'error');
                    btn.disabled = false;
                    btn.innerHTML = '🔄 立即更新';
                }
            } catch (e) {
                showToast('❌ 更新失败: ' + e.message, 'error');
                btn.disabled = false;
                btn.innerHTML = '🔄 立即更新';
            }
            
            isRefreshing = false;
        }
        
        function fmtPct(v) { return (v>=0?"+":"") + v.toFixed(2) + "%"; }
        function cls(v) { return v>=0?"up":"down"; }
        function arrow(v) { return v>=0?"↑":"↓"; }
        
        // 打开AI分析弹窗
        function openAIAnalysis(code, name) {
            currentFund = { code, name };
            const modal = document.getElementById('aiModal');
            const content = document.getElementById('aiReportContent');
            
            modal.classList.add('show');
            content.innerHTML = '<div class="loading"><div class="spinner"></div><p>正在分析 ' + name + '，请稍候...</p></div>';
            
            // 调用AI分析API
            fetch('/api/analyze/' + code)
                .then(r => r.json())
                .then(data => {
                    if (data.error) {
                        content.innerHTML = '<div class="ai-risk">❌ ' + data.error + '</div>';
                    } else {
                        renderAIReport(data);
                    }
                })
                .catch(e => {
                    content.innerHTML = '<div class="ai-risk">❌ 分析失败: ' + e.message + '</div>';
                });
        }
        
        function closeModal() {
            document.getElementById('aiModal').classList.remove('show');
        }
        
        function renderAIReport(data) {
            const content = document.getElementById('aiReportContent');
            
            const score = data.score || 0;
            const rec = data.recommendation || '持有';
            let adviceClass = 'hold';
            if (rec.includes('买入') || rec.includes('加仓')) adviceClass = 'buy';
            if (rec.includes('卖出') || rec.includes('减仓')) adviceClass = 'sell';
            
            const ret1m = data.return_1m || 0;
            const ret3m = data.return_3m || 0;
            const sharpe = data.sharpe || 0;
            const maxDd = data.max_drawdown || 0;
            
            let html = '<div class="ai-report">';
            
            // 评分
            html += '<div class="ai-score">';
            html += '<div class="score-value">' + score + '</div>';
            html += '<div class="score-label">' + rec + '</div>';
            html += '<div class="score-bar"><div class="score-bar-inner" style="width:' + score + '%"></div></div>';
            html += '</div>';
            
            // 基础指标
            html += '<div class="ai-section">';
            html += '<div class="ai-section-title">📊 基础指标</div>';
            html += '<div class="ai-metrics">';
            html += '<div class="ai-metric"><div class="label">近1月</div><div class="value ' + cls(ret1m) + '">' + fmtPct(ret1m) + '</div></div>';
            html += '<div class="ai-metric"><div class="label">近3月</div><div class="value ' + cls(ret3m) + '">' + fmtPct(ret3m) + '</div></div>';
            html += '<div class="ai-metric"><div class="label">夏普比率</div><div class="value">' + sharpe.toFixed(2) + '</div></div>';
            html += '<div class="ai-metric"><div class="label">最大回撤</div><div class="value down">' + maxDd.toFixed(1) + '%</div></div>';
            html += '<div class="ai-metric"><div class="label">波动率</div><div class="value">' + (data.volatility || 0).toFixed(1) + '%</div></div>';
            html += '<div class="ai-metric"><div class="label">估值位置</div><div class="value">' + (data.position || '正常') + '</div></div>';
            html += '</div></div>';
            
            // 技术分析
            html += '<div class="ai-section">';
            html += '<div class="ai-section-title">📈 技术分析</div>';
            html += '<div class="ai-text">';
            html += '<p>• 当前趋势: <strong>' + (data.trend || '未知') + '</strong></p>';
            html += '<p>• 5日均线: ' + (data.ma5 || 0).toFixed(4) + '</p>';
            html += '<p>• 20日均线: ' + (data.ma20 || 0).toFixed(4) + '</p>';
            html += '<p>• 5日动量: ' + (data.momentum_5d || 0).toFixed(2) + '%</p>';
            html += '</div></div>';
            
            // 操作建议
            html += '<div class="ai-section">';
            html += '<div class="ai-section-title">🎯 操作建议</div>';
            html += '<div class="ai-advice ' + adviceClass + '">';
            html += '<div class="advice-title">' + rec + '</div>';
            html += '<div class="ai-text">' + (data.ai_report || '暂无详细建议') + '</div>';
            html += '</div></div>';
            
            // 风险提示
            html += '<div class="ai-section">';
            html += '<div class="ai-section-title">⚠️ 风险提示</div>';
            html += '<div class="ai-risk">';
            html += '<p>• 基金过往业绩不代表未来表现</p>';
            html += '<p>• 市场有风险，投资需谨慎</p>';
            html += '</div></div>';
            
            // 时间戳
            html += '<div style="text-align:center;color:#999;font-size:0.85em;margin-top:20px;">';
            html += '⏰ 分析时间: ' + (data.timestamp || new Date().toLocaleString());
            html += '</div>';
            
            html += '</div>';
            
            content.innerHTML = html;
        }
        
        function renderHoldings(data) {
            if (!data || !data.length) { 
                document.getElementById("content").innerHTML = "<div class=card><p>暂无持仓</p></div>"; 
                return; 
            }
            
            let h = '<div class=card><button class=btn onclick=loadData()>🔄 刷新</button></div><div class=fund-grid>';
            
            for (const f of data) {
                const hasAct = f.actual_nav > 0;
                const dispChg = hasAct ? f.actual_change : f.estimated_change;
                const profitCls = f.profit_pct >= 0 ? "profit":"loss";
                const tag = hasAct ? "<span class='tag tag-actual'>实际</span>" : "<span class='tag tag-estimate'>估算</span>";
                
                h += "<div class=fund-card>";
                h += "<div class=fund-card-header><h3>" + f.name + "</h3><span class=code>" + f.code + "</span></div>";
                h += "<div class=fund-card-body>";
                h += "<div class=fund-stat><div class=label>当前净值</div><div class=value>" + (f.current_nav||0).toFixed(4) + "</div></div>";
                h += "<div class=fund-stat><div class=label>今日涨跌</div><div class='value " + cls(dispChg) + "'>" + arrow(dispChg) + " " + Math.abs(dispChg).toFixed(2) + "% " + tag + "</div></div>";
                h += "<div class=fund-stat><div class=label>持仓成本</div><div class=value>" + (f.cost||0).toFixed(4) + "</div></div>";
                h += "<div class=fund-stat><div class=label>持仓盈亏</div><div class='value " + profitCls + "'>" + fmtPct(f.profit_pct) + "</div></div>";
                h += "</div>";
                h += "<div class=fund-card-actions>";
                h += "<button class=btn onclick=loadData()>🔄 刷新</button>";
                h += "<button class='btn btn-ai' onclick=openAIAnalysis('" + f.code + "','" + f.name + "')>🤖 AI分析</button>";
                h += "</div></div>";
            }
            
            document.getElementById("content").innerHTML = h + "</div>";
        }
        
        function renderRecommend(data) {
            if (!data || !data.strategies) return;
            
            document.getElementById("update-time").textContent = "更新时间: " + (data.update_time || "-");
            
            const strategyNames = {
                'momentum': '📈 趋势动量型',
                'value': '💎 价值低估型', 
                'stable': '🛡️ 稳健收益型',
                'hot': '🔥 热点轮动型'
            };
            
            let h = '';
            
            // 热点板块
            if (data.hot_sectors && data.hot_sectors.length) {
                h += '<div class=hot-sectors>';
                data.hot_sectors.forEach(s => {
                    h += '<span class=sector-tag>🔥 ' + s.sector + ' (热度:' + s.score + ')</span>';
                });
                h += '</div>';
            }
            
            // 各策略推荐
            for (const [key, strategy] of Object.entries(data.strategies)) {
                if (!strategy.funds || !strategy.funds.length) continue;
                
                h += '<div class=rec-section>';
                h += '<div class=rec-header>';
                h += '<div class=rec-title>' + strategyNames[key] + '</div>';
                h += '</div>';
                h += '<div class=fund-grid>';
                
                for (const f of strategy.funds) {
                    const ret1m = f.return_1m || 0;
                    const ret3m = f.return_3m || 0;
                    const sharpe = f.sharpe_6m || 0;
                    const maxDd = f.max_drawdown || 0;
                    
                    h += '<div class=fund-card>';
                    h += '<div class=fund-card-header><h3>' + f.name + '</h3><span class=code>' + f.code + '</span></div>';
                    h += '<div class=fund-card-body>';
                    if (f.sector) {
                        h += '<div class=fund-stat style="grid-column:span 4;"><div class=label>所属板块</div><div class=value style="font-size:1em;">' + f.sector + '</div></div>';
                    }
                    h += '<div class=fund-stat><div class=label>近1月</div><div class="value ' + cls(ret1m) + '">' + arrow(ret1m) + ' ' + Math.abs(ret1m).toFixed(2) + '%</div></div>';
                    h += '<div class=fund-stat><div class=label>近3月</div><div class="value ' + cls(ret3m) + '">' + arrow(ret3m) + ' ' + Math.abs(ret3m).toFixed(2) + '%</div></div>';
                    h += '<div class=fund-stat><div class=label>夏普比率</div><div class="value">' + sharpe.toFixed(2) + '</div></div>';
                    h += '<div class=fund-stat><div class=label>最大回撤</div><div class="value down">' + maxDd.toFixed(2) + '%</div></div>';
                    h += '</div>';
                    if (f.reason) {
                        h += '<div class="fund-stat" style="grid-column:span 4;margin-top:10px;padding:10px;background:#f8f9fa;border-radius:8px;"><div class=label>推荐理由</div><div style="font-size:0.9em;color:#666;">📋 ' + f.reason + '</div></div>';
                    }
                    h += '<div class=risk-warning>⚠️ 投资有风险，入市需谨慎</div>';
                    h += '</div>';
                }
                
                h += '</div></div>';
            }
            
            document.getElementById("content").innerHTML = h;
            document.getElementById('btn-refresh').disabled = false;
            document.getElementById('btn-refresh').innerHTML = '🔄 立即更新';
        }
        
        // 点击弹窗外部关闭
        document.getElementById('aiModal').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });
        
        loadData();
        setInterval(loadData, 300000);
    </script>
</body>
</html>
