"""Flask Web 应用 - 基金量化助手"""
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).parent.parent))

from flask import Flask, jsonify, render_template
import json
import threading

from core.fund_api import get_realtime_quote, get_historical_nav, POPULAR_FUNDS
from core.holdings import HoldingsManager

app = Flask(__name__, template_folder='templates')
DATA_DIR = Path(__file__).parent.parent / 'data'
ACTUAL_NAV_FILE = DATA_DIR / 'actual_navs.json'
mgr = HoldingsManager()


@app.route('/')
def index():
    """主页"""
    return render_template('index.html')


@app.route('/api/holdings')
def api_holdings():
    """获取持仓列表"""
    holdings = mgr.list()
    result = []
    for h in holdings:
        quote = get_realtime_quote(h['code'])
        if quote:
            result.append({
                **h,
                'price': quote.get('price'),
                'change_pct': quote.get('change_pct'),
            })
    return jsonify(result)


@app.route('/api/quotes')
def api_quotes():
    """获取行情数据 - 合并估算净值和实际净值"""
    holdings = mgr.list()
    
    actual_navs = {}
    if ACTUAL_NAV_FILE.exists():
        with open(ACTUAL_NAV_FILE, 'r', encoding='utf-8') as f:
            actual_navs = json.load(f)
    
    results = []
    for h in holdings:
        code = h['code']
        quote = get_realtime_quote(code)
        
        if quote:
            cost = h.get('cost', 0)
            
            est_nav = quote.get('estimated_nav', 0)
            est_chg = quote.get('change_pct', 0)
            
            act = actual_navs.get(code, {})
            act_nav = act.get('nav', 0)
            act_chg = act.get('daily_return', 0) or 0
            act_date = act.get('date', '')
            
            hist = get_historical_nav(code, 5)
            yes_nav = hist[-2].get('nav', 0) if len(hist) >= 2 else 0
            
            disp_nav = act_nav if act_nav > 0 else est_nav
            profit = ((disp_nav - cost) / cost * 100) if cost > 0 else 0
            
            results.append({
                'code': code,
                'name': h['name'],
                'cost': cost,
                'current_nav': disp_nav,
                'estimated_nav': est_nav,
                'actual_nav': act_nav,
                'yesterday_nav': yes_nav,
                'estimated_change': round(est_chg, 2),
                'actual_change': round(act_chg, 2),
                'actual_date': act_date,
                'profit_pct': round(profit, 2),
                'update_time': quote.get('update_time', ''),
            })
    
    return jsonify(results)


@app.route('/api/popular')
def api_popular():
    """热门基金推荐（旧版，保留兼容）"""
    results = []
    for code, name in POPULAR_FUNDS.items():
        quote = get_realtime_quote(code)
        if quote:
            results.append({
                'code': code,
                'name': name,
                'price': quote.get('price'),
                'change_pct': quote.get('change_pct'),
            })
    return jsonify(results)


@app.route('/api/recommendations')
def api_recommendations():
    """智能基金推荐"""
    rec_file = DATA_DIR / 'recommendations.json'
    
    if rec_file.exists():
        with open(rec_file, 'r', encoding='utf-8') as f:
            data = json.load(f)
        return jsonify(data)
    
    return jsonify({'error': '暂无推荐数据，请稍后刷新'}), 404


@app.route('/api/recommendations/refresh', methods=['POST'])
def api_refresh_recommendations():
    """手动刷新推荐（供前端按钮调用）"""
    def background_refresh():
        try:
            from core.smart_recommender import SmartRecommender
            recommender = SmartRecommender(max_workers=5)
            recommender.save_recommendations()
        except Exception as e:
            print("刷新推荐失败:", e)
    
    thread = threading.Thread(target=background_refresh)
    thread.daemon = True
    thread.start()
    
    return jsonify({'status': 'success', 'message': '正在后台刷新推荐，请稍后刷新页面查看最新结果'})


@app.route('/api/quote/<code>')
def api_quote(code):
    """单个基金行情"""
    quote = get_realtime_quote(code)
    if quote:
        return jsonify(quote)
    return jsonify({'error': '获取失败'}), 404


@app.route('/api/analyze/<code>')
def api_analyze(code):
    """AI分析单只基金"""
    try:
        # 从环境变量或配置文件获取API Key
        api_key = None
        try:
            import os
            api_key = os.environ.get('MINIMAX_API_KEY')
        except:
            pass
        
        from core.fund_ai_analyzer import FundAIAnalyzer
        analyzer = FundAIAnalyzer(api_key=api_key)
        result = analyzer.analyze(code)
        
        if result:
            return jsonify(result)
        else:
            return jsonify({'error': '分析失败，请检查基金代码是否正确'}), 400
    except Exception as e:
        return jsonify({'error': f'分析出错: {str(e)}'}), 500


if __name__ == '__main__':
    app.run(host='0.0.0.0', port=8080, debug=False)
