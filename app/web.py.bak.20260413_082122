@app.route('/api/holdings')
def api_holdings():
    """获取持仓列表"""
    holdings = mgr.list()
    
    # 补充实时行情
    result = []
    for h in holdings:
        quote = get_realtime_quote(h['code'])
        if quote:
            cost = h.get('cost', 0)
            profit_pct = ((quote['price'] - cost) / cost * 100) if cost > 0 else 0
            result.append({
                **h,
                'current_nav': quote['price'],
                'change_pct': quote['change_pct'],
                'profit_pct': round(profit_pct, 2),
                'update_time': quote['update_time'],
            })
        else:
            result.append({**h, 'error': '获取失败'})
    
    return jsonify({'success': True, 'data': result})


@app.route('/api/holdings', methods=['POST'])
def api_add_holding():
    """添加持仓"""
    data = request.json
    code = data.get('code', '').strip()
    name = data.get('name', '')
    
    if not code:
        return jsonify({'success': False, 'error': '请输入基金代码'})
    
    # 自动获取基金名称
    if not name:
        quote = get_realtime_quote(code)
        if quote:
            name = quote['name']
    
    success = mgr.add(
        code=code,
        name=name,
        shares=data.get('shares', 0),
        cost=data.get('cost', 0),
        note=data.get('note', '')
    )
    
    if success:
        return jsonify({'success': True, 'message': f'已添加 {name}'})
    else:
        return jsonify({'success': False, 'error': '该基金已存在'})


@app.route('/api/holdings/<code>', methods=['DELETE'])
def api_delete_holding(code):
    """删除持仓"""
    success = mgr.remove(code)
    return jsonify({'success': success, 'message': '已删除' if success else '删除失败'})


