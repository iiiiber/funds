#!/usr/bin/env python3
"""FundQuant Web 服务器"""
import sys
import json
from pathlib import Path
from http.server import HTTPServer, SimpleHTTPRequestHandler
import urllib.parse

# 添加项目根目录
sys.path.insert(0, str(Path(__file__).parent.parent))

from core.fund_api import get_realtime_quote, get_historical_nav
from core.holdings import HoldingsManager
from core.analysis import analyze_fund


class FundQuantHandler(SimpleHTTPRequestHandler):
    """HTTP 请求处理器"""
    
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(Path(__file__).parent / 'static'), **kwargs)
    
    def do_GET(self):
        """处理 GET 请求"""
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        
        if path == '/':
            self.serve_index()
        elif path == '/api/holdings':
            self.serve_holdings()
        elif path == '/api/quotes':
            self.serve_quotes()
        elif path.startswith('/api/quote/'):
            code = path.split('/')[-1]
            self.serve_single_quote(code)
        elif path == '/api/popular':
            self.serve_popular_funds()
        else:
            super().do_GET()
    
    def serve_index(self):
        """主页"""
        self.send_response(200)
        self.send_header('Content-type', 'text/html; charset=utf-8')
        self.end_headers()
        self.wfile.write(self.get_html().encode('utf-8'))
    
    def serve_holdings(self):
        """持仓列表 API"""
        mgr = HoldingsManager()
        holdings = mgr.list()
        self.send_json(holdings)
    
    def serve_quotes(self):
        """行情 API"""
        mgr = HoldingsManager()
        holdings = mgr.list()
        
        results = []
        for h in holdings:
            quote = get_realtime_quote(h['code'])
            if quote:
                cost = h.get('cost', 0)
                profit_pct = ((quote['price'] - cost) / cost * 100) if cost > 0 else 0
                results.append({
                    **h,
                    'current_nav': quote['price'],
                    'change_pct': quote['change_pct'],
                    'profit_pct': round(profit_pct, 2),
                    'update_time': quote['update_time'],
                })
        
        self.send_json(results)
    
    def serve_single_quote(self, code):
        """单个基金行情"""
        quote = get_realtime_quote(code)
        if quote:
            self.send_json(quote)
        else:
            self.send_json({'error': '获取失败'}, status=404)
    
    def serve_popular_funds(self):
        """热门基金推荐"""
        from core.fund_api import POPULAR_FUNDS
        results = []
        for code, name in POPULAR_FUNDS.items():
            quote = get_realtime_quote(code)
            if quote:
                results.append({
                    'code': code,
                    'name': name,
                    'price': quote['price'],
                    'change_pct': quote['change_pct'],
                })
        self.send_json(results)
    
    def send_json(self, data, status=200):
        """发送 JSON 响应"""
        self.send_response(status)
        self.send_header('Content-type', 'application/json; charset=utf-8')
        self.send_header('Access-Control-Allow-Origin', '*')
        self.end_headers()
        self.wfile.write(json.dumps(data, ensure_ascii=False).encode('utf-8'))
    
    def get_html(self):
        """生成主页 HTML"""
        return '''<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FundQuant - 基金量化助手</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
               background: #f5f7fa; color: #333; }
        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
        
        /* 头部 */
        header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); 
                 color: white; padding: 30px 0; margin-bottom: 30px; border-radius: 0 0 20px 20px; }
        header h1 { text-align: center; font-size: 2.5em; }
        header p { text-align: center; opacity: 0.9; margin-top: 10px; }
        
        /* 标签页 */
        .tabs { display: flex; gap: 10px; margin-bottom: 20px; }
        .tab { padding: 12px 24px; background: white; border: none; border-radius: 10px; 
               cursor: pointer; font-size: 16px; transition: all 0.3s; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        .tab:hover { transform: translateY(-2px); }
        .tab.active { background: #667eea; color: white; }
        
        /* 卡片 */
        .card { background: white; border-radius: 15px; padding: 20px; margin-bottom: 20px; 
                box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .card h2 { margin-bottom: 15px; color: #667eea; }
        
        /* 持仓表格 */
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 15px; text-align: left; border-bottom: 1px solid #eee; }
        th { background: #f8f9fa; font-weight: 600; }
        tr:hover { background: #f8f9fa; }
        
        /* 涨跌颜色 */
        .up { color: #e74c3c; }
        .down { color: #27ae60; }
        .profit { color: #e74c3c; font-weight: bold; }
        .loss { color: #27ae60; font-weight: bold; }
        
        /* 按钮 */
        .btn { padding: 10px 20px; background: #667eea; color: white; border: none; 
               border-radius: 8px; cursor: pointer; font-size: 14px; transition: all 0.3s; }
        .btn:hover { background: #764ba2; transform: translateY(-2px); }
        .btn-refresh { float: right; }
        
        /* 加载动画 */
        .loading { text-align: center; padding: 40px; color: #999; }
        .spinner { width: 40px; height: 40px; border: 4px solid #f3f3f3; 
                   border-top: 4px solid #667eea; border-radius: 50%; 
                   animation: spin 1s linear infinite; margin: 0 auto 15px; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        
        /* 推荐基金 */
        .fund-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 15px; }
        .fund-item { background: #f8f9fa; padding: 15px; border-radius: 10px; }
        .fund-item h4 { color: #667eea; margin-bottom: 10px; }
        
        /* 响应式 */
        @media (max-width: 768px) {
            header h1 { font-size: 1.8em; }
            .tabs { flex-wrap: wrap; }
            table { font-size: 14px; }
            th, td { padding: 10px; }
        }
    </style>
</head>
<body>
    <header>
        <h1>📊 FundQuant</h1>
        <p>基金量化助手 - 追踪行情 · 智能分析</p>
    </header>
    
    <div class="container">
        <div class="tabs">
            <button class="tab active" onclick="showTab('holdings')">📋 我的持仓</button>
            <button class="tab" onclick="showTab('recommend')">🏆 热门推荐</button>
        </div>
        
        <div id="content">
            <div class="loading">
                <div class="spinner"></div>
                <p>加载中...</p>
            </div>
        </div>
    </div>
    
    <script>
        let currentTab = 'holdings';
        
        function showTab(tab) {
            currentTab = tab;
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            event.target.classList.add('active');
            loadData();
        }
        
        async function loadData() {
            const content = document.getElementById('content');
            content.innerHTML = '<div class="loading"><div class="spinner"></div><p>加载中...</p></div>';
            
            if (currentTab === 'holdings') {
                const resp = await fetch('/api/quotes');
                const data = await resp.json();
                renderHoldings(data);
            } else {
                const resp = await fetch('/api/popular');
                const data = await resp.json();
                renderRecommend(data);
            }
        }
        
        function renderHoldings(data) {
            if (!data || data.length === 0) {
                document.getElementById('content').innerHTML = `
                    <div class="card">
                        <p>暂无持仓，请在 data/holdings.json 中添加基金</p>
                    </div>`;
                return;
            }
            
            let html = `
                <div class="card">
                    <h2>📋 我的持仓</h2>
                    <button class="btn btn-refresh" onclick="loadData()">🔄 刷新</button>
                    <table>
                        <thead>
                            <tr>
                                <th>基金代码</th>
                                <th>基金名称</th>
                                <th>最新净值</th>
                                <th>估算涨跌</th>
                                <th>持仓成本</th>
                                <th>持仓盈亏</th>
                            </tr>
                        </thead>
                        <tbody>`;
            
            for (const f of data) {
                const changeClass = f.change_pct >= 0 ? 'up' : 'down';
                const profitClass = f.profit_pct >= 0 ? 'profit' : 'loss';
                const sign = f.change_pct >= 0 ? '+' : '';
                const profitSign = f.profit_pct >= 0 ? '+' : '';
                
                html += `
                            <tr>
                                <td>${f.code}</td>
                                <td>${f.name}</td>
                                <td>¥${f.current_nav?.toFixed(4) || '-'}</td>
                                <td class="${changeClass}">${sign}${f.change_pct?.toFixed(2) || 0}%</td>
                                <td>¥${f.cost?.toFixed(4) || '-'}</td>
                                <td class="${profitClass}">${profitSign}${f.profit_pct?.toFixed(2) || 0}%</td>
                            </tr>`;
            }
            
            html += `</tbody></table></div>`;
            document.getElementById('content').innerHTML = html;
        }
        
        function renderRecommend(data) {
            let html = '<div class="card"><h2>🏆 热门基金推荐</h2><p style="margin-bottom:15px;color:#666;">基于公开市场数据筛选，投资有风险</p><div class="fund-grid">';
            
            for (const f of data) {
                const changeClass = f.change_pct >= 0 ? 'up' : 'down';
                const sign = f.change_pct >= 0 ? '+' : '';
                
                html += `
                    <div class="fund-item">
                        <h4>${f.code} ${f.name}</h4>
                        <p>最新净值: ¥${f.price?.toFixed(4) || '-'}</p>
                        <p class="${changeClass}">今日涨跌: ${sign}${f.change_pct?.toFixed(2) || 0}%</p>
                    </div>`;
            }
            
            html += '</div></div>';
            document.getElementById('content').innerHTML = html;
        }
        
        // 首次加载
        loadData();
        
        // 每5分钟自动刷新
        setInterval(loadData, 300000);
    </script>
</body>
</html>'''


def run(port=8080):
    """启动服务器"""
    server = HTTPServer(('0.0.0.0', port), FundQuantHandler)
    print(f"🚀 FundQuant 服务器启动: http://localhost:{port}")
    print("按 Ctrl+C 停止服务器")
    server.serve_forever()


if __name__ == '__main__':
    import argparse
    parser = argparse.ArgumentParser()
    parser.add_argument('-p', '--port', type=int, default=8080)
    args = parser.parse_args()
    run(args.port)
